{
  "schema_version": 1,
  "id": "docs-reference",
  "name": "Docs Reference",
  "description": "适合产品文档、项目手册与结构化知识库的 Wiki 站点。",
  "default_style": "stellar",
  "files": [
    {
      "source": "_config.stellar.yml",
      "target": "_config.stellar.yml",
      "template": true
