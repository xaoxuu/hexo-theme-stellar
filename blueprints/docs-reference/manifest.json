      "target": "source/_data/wiki.yml",
      "template": false
    },
    {
      "source": "source/_data/wiki/docs-reference.yml",
      "target": "source/_data/wiki/docs-reference.yml",
      "template": false
    },
    {
      "source": "source/wiki/docs-reference/index.md",
      "target": "source/wiki/docs-reference/index.md",
      "template": false
    },
    {
      "source": "source/wiki/docs-reference/getting-started.md",
      "target": "source/wiki/docs-reference/getting-started.md",
      "template": false
    }
  ]
}
