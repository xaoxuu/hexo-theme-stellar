{
  "schemaVersion": 1,
  "source": [
    "scripts/schema/blueprint-schema.js",
    "blueprints/*/manifest.json",
    "blueprints/styles/*/manifest.json"
  ],
  "status": "delivered",
  "manifestContract": {
    "schemaVersion": 1,
    "sealed": true,
    "blueprintIds": [
      "classic",
      "minimal-reading",
      "docs-reference",
      "light-and-shadow"
    ],
    "visualStyleIds": [
      "card",
      "flat",
      "glass",
      "minimal"
    ],
    "paths": "safe non-empty relative path",
    "uniqueBlueprintTargets": true,
    "physicalContainment": "theme and site roots, including symlink resolution"
  },
  "blueprints": [
    {
      "id": "classic",
      "name": "Classic",
      "description": "使用 Leftbar 设置入口的经典个人博客，适合持续发布文章、分类与标签内容。",
      "defaultStyle": "card",
      "files": [
        "_config.stellar.yml",
        "source/_posts/welcome-to-stellar.md"
      ]
    },
    {
      "id": "minimal-reading",
      "name": "Minimal Reading",
      "description": "在 Topbar 展示设置入口的低干扰长文与随笔站点。",
      "defaultStyle": "minimal",
      "files": [
        "_config.stellar.yml",
        "source/_posts/a-quiet-place-to-write.md"
      ]
    },
    {
      "id": "docs-reference",
      "name": "Docs Reference",
      "description": "使用 Topbar 导航与 Leftbar 设置入口的结构化 Wiki 文档站。",
      "defaultStyle": "card",
      "files": [
        "_config.stellar.yml",
        "source/_data/wiki.yml",
        "source/_data/wiki/docs-reference.yml",
        "source/wiki/docs-reference/index.md",
        "source/wiki/docs-reference/getting-started.md"
      ]
    },
    {
      "id": "light-and-shadow",
      "name": "Light and Shadow",
      "description": "以 Glass 与 Topbar 设置入口营造沉浸式作品站。",
      "defaultStyle": "glass",
      "files": [
        "_config.stellar.yml",
        "source/_posts/welcome-to-light-and-shadow.md"
      ]
    }
  ],
  "visualStyles": [
    {
      "id": "card",
      "name": "Card",
      "description": "清晰的实体卡片、边界与层级。"
    },
    {
      "id": "flat",
      "name": "Flat",
      "description": "半透明平面、轻量模糊与清晰分隔线。"
    },
    {
      "id": "glass",
      "name": "Glass",
      "description": "半透明表面、柔和模糊与光影层次。"
    },
    {
      "id": "minimal",
      "name": "Minimal",
      "description": "以正文为中心的克制色彩、紧凑圆角与低动效。"
    }
  ],
  "cli": {
    "command": "stellar",
    "subcommands": {
      "init": {
        "options": [
          "blueprint",
          "style",
          "dry-run",
          "non-interactive"
        ]
      },
      "doctor": {
        "formats": [
          "text",
          "json"
        ],
        "options": [
          "format"
        ],
        "jsonGlobalOptions": [
          "silent"
        ]
      }
    }
  }
}
