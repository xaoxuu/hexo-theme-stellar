<script>
  // 防御：bootstrap 被第三方优化器改写/移除导致 window.stellar.initPlugin 缺失时，
  // 在此补一个等价注册点：utils 就绪时直接委托，未就绪时入队，utils 加载后自动补跑。
  if (typeof window.stellar === 'undefined' || typeof window.stellar.initPlugin !== 'function') {
    window.stellar = window.stellar || {};
    window.stellar._pluginQueue = window.stellar._pluginQueue || [];
    window.stellar.initPlugin = function (fn, name, options) {
      if (typeof utils === 'object' && typeof utils.initPlugin === 'function') {
        return utils.initPlugin(fn, name, options);
      }
      window.stellar._pluginQueue.push({ fn: fn, name: name, options: options || {} });
    };
    window.stellar._flushPlugins = function () {
      var pending = window.stellar._pluginQueue.splice(0);
      if (typeof utils !== 'object' || typeof utils.initPlugin !== 'function') return;
      for (var i = 0; i < pending.length; i++) {
        try {
          utils.initPlugin(pending[i].fn, pending[i].name, pending[i].options);
        } catch (e) {
          console.error('[Stellar] 插件补注册失败:', e);
        }
      }
    };
  }
</script>
<%
function loadPlugins() {
  var el = ''
  var render = content_config(page).render || {}

  function pageFeature(id) {
    if (id === 'katex' || id === 'mathjax') {
      return render.math === id
    }
    if (id === 'mermaid') {
      if (render.diagrams === true || render.diagrams === 'mermaid') return true
      if (render.diagrams && typeof render.diagrams === 'object') return render.diagrams
    }
    return false
  }

  // search
  if (theme.search[theme.search.service]) {
    el += `<script>window.addEventListener('DOMContentLoaded', function () { utils.js('/js/search/shortcut.js', { defer: true }); });</script>`;
    el += partial(`search/${theme.search.service}`, {conf: theme.search[theme.search.service]});
  }
  
  // others
  for (var id of Object.keys(theme.plugins)) {
    var pageConf = pageFeature(id)
    var conf = Object.assign({}, theme.plugins[id], pageConf && typeof pageConf === 'object' ? pageConf : {})
    if (pageConf === true || conf.enable) {
      if (conf.inject?.length > 0) {
        el += conf.inject
      } else {
        el += partial(`${id}`, {conf: conf})
      }
    }
  }
  return el
}
%>
<%- loadPlugins() %>
