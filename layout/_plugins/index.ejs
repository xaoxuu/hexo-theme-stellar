<script>
  // 防御：bootstrap 被第三方优化器改写/移除导致 window.stellar.initPlugin 缺失时，
  // 在此补一个等价注册点：utils 就绪时直接委托，未就绪时入队，utils 加载后自动补跑。
  if (typeof window.stellar === 'undefined' || typeof window.stellar.initPlugin !== 'function') {
    window.stellar = window.stellar || {};
    window.stellar._pluginQueue = window.stellar._pluginQueue || [];
    window.stellar.initPlugin = function (fn, name, options) {
      if (typeof utils === 'object' && typeof utils.initPlugin === 'function') {
        return utils.initPlugin(fn, name, options);
      }
      window.stellar._pluginQueue.push({ fn: fn, name: name, options: options || {} });
    };
    window.stellar._flushPlugins = function () {
      var pending = window.stellar._pluginQueue.splice(0);
      if (typeof utils !== 'object' || typeof utils.initPlugin !== 'function') return;
      for (var i = 0; i < pending.length; i++) {
        try {
          utils.initPlugin(pending[i].fn, pending[i].name, pending[i].options);
        } catch (e) {
          console.error('[Stellar] 插件补注册失败:', e);
        }
      }
    };
  }
</script>
<%
function loadPlugins() {
  var el = ''
  var render = content_config(page).render || {}
  var extensions = stellar_config('extensions')
  var features = extensions.features

  // search
  var searchProvider = extensions.search.provider
  var searchPartials = {local: 'local_search', algolia: 'algolia_search'}
  if (searchProvider && searchPartials[searchProvider] && extensions.search.providers[searchProvider]) {
    el += `<script>window.addEventListener('DOMContentLoaded', function () { utils.js('/js/search/shortcut.js', { defer: true }); });</script>`;
    el += partial(`search/${searchPartials[searchProvider]}`, {conf: extensions.search.providers[searchProvider]});
  }

  var featurePartials = {
    preload: 'preload',
    lightbox: 'fancybox',
    reveal: 'scrollreveal',
    aiSummary: 'tianli_gpt',
    codeCopy: 'copycode',
    adaptiveText: 'adaptive_text',
    cardHover: 'card_hover',
    cjkTypography: 'heti'
  }
  for (var featureId of Object.keys(featurePartials)) {
    var feature = features[featureId]
    if (feature.enabled) {
      el += partial(featurePartials[featureId], {conf: feature})
    }
  }

  var mathProvider = render.math || features.math.provider
  if (mathProvider === 'katex') {
    el += partial('katex', {conf: features.math.providers.katex})
  } else if (mathProvider === 'mathjax') {
    el += partial('mathjax', {conf: features.math.providers.mathjax})
  }

  if (render.diagrams || features.diagrams.enabled) {
    var diagramOptions = render.diagrams && typeof render.diagrams === 'object' ? render.diagrams : {}
    el += partial('mermaid', {conf: Object.assign({}, features.diagrams, diagramOptions)})
  }

  // Swiper 是主题内置容器能力，资源按页面 DOM 需求加载，不再开放用户配置。
  el += partial('swiper', {conf: {}})
  return el
}
%>
<%- loadPlugins() %>
