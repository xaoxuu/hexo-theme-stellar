<%
function layout_wiki_list(partial) {
  var el = ''
  var wikiIndex = page.wikiIndex
  if (!wikiIndex || !Array.isArray(wikiIndex.items)) {
    throw new Error('Stellar v2: Wiki 索引模板缺少显式 listing 数据')
  }
  for (var listing of wikiIndex.items) {
    el += `<div class="post-card-wrap${scrollreveal(' ')}${wikiIndex.filter ? ' filter' : ''}">`
    var coverStyle = ''
    var cover = listing.cover
    if (cover) {
      coverStyle = ` style="--cover-url:url('${escape_html(cover.replace(/'/g, '%27'))}')"`
    }
    el += `<a class="${ui_classes('wiki-card', 'hoverCard', cover ? '' : 'no-cover')}"${coverStyle} href="${pretty_url(listing.href || '/')}">`
    el += partial(listing)
    el += `</a>`
    el += `</div>`
  }
  return el
}

function layoutDiv() {
  var el = ''
  el += partial('_partial/main/listing_nav/wiki', {wikiIndex: page.wikiIndex})
  el += `<div class="post-list wiki">`;
  el += layout_wiki_list(function(listing) {
    return partial('_partial/main/post_list/wiki_card', {listing: listing})
  })
  el += `</div>`
  return el
}
%>

<%- layoutDiv() %>
<script defer src="<%- url_for('/js/wiki-index.js') %>?v=<%- stellar_info('version') %>"></script>
