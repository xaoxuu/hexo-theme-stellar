<%
const { layout } = page
const postViewModel = page.viewModel?.collection?.profile === 'post' ? page.viewModel : null
var pageConfig = content_config(page)
// 是否使用 Heti 布局插件
const isUsingHeti = theme.plugins.heti?.enable

const notebook = theme.notebooks.tree[collection_id(page, "notebook")]
if (!postViewModel && notebook) {
  page.navigation = Object.assign({}, pageConfig.navigation)
  page.footer = Object.assign({}, pageConfig.footer)
  page.navigation.menu ??= notebook.navigation?.menu ?? stellar_config('layout.profiles.note.navigation.activeMenu')
  page.footer.license ??= notebook.footer?.license
  page.footer.share ??= notebook.footer?.share
}

// 默认主导航菜单
if (!postViewModel && !notebook) page.navigation = Object.assign({}, pageConfig.navigation)
if (!postViewModel && page.navigation.menu == null) {
  var profiles = stellar_config('layout.profiles')
  if (collection_id(page, "wiki")?.length > 0) {
    page.navigation.menu = profiles.wiki.navigation.activeMenu
  } else if (collection_id(page, "topic")?.length > 0) {
    page.navigation.menu = profiles.topic.navigation.activeMenu
  } else if (notebook) {
    page.navigation.menu = profiles.note.navigation.activeMenu
  } else if (page.layout === 'page' || page.layout == null) {
    page.navigation.menu = profiles.page.navigation.activeMenu
  } else {
    page.navigation.menu = profiles.post.navigation.activeMenu
  }
}
// 默认的 title
if (page.title == null) {
  if (collection_id(page, "wiki")) {
    page.title = __('btn.wiki')
  }
}

function articleClass() {
  var str = `md-text content${scrollreveal(' ')}`
  if (isUsingHeti) {
    str += ' heti'
  }
  return str
}

function postArticleClass(article) {
  var str = `md-text content${scrollreveal(' ')}`
  if (article.heti) str += ' heti'
  return str
}

function postLayoutDiv() {
  var item = postViewModel.item
  var article = postViewModel.render.article
  var el = ''
  if (item.presentation.banner?.headline || item.title || item.content.length > 0) {
    el += partial('_partial/main/navbar/article_banner', {viewModel: postViewModel})
  }
  el += `<article class="${postArticleClass(article)}">`
  el += item.content
  el += '</article>'
  el += partial('_partial/main/article/post_tags', {tags: article.tags})
  el += partial('_partial/main/article/post_footer', {footer: article.footer})
  el += partial('_partial/main/article/post_read_next', {
    previous: article.previous,
    next: article.next
  })
  el += partial('_partial/main/article/post_related', {related: article.related})
  page.cmt_rendered = article.comments.enabled
  el += partial('_partial/comments/layout', {comments: article.comments})
  return el
}

function layoutDiv() {
  if (postViewModel) return postLayoutDiv()
  var el = ''
  if (pageConfig.banner?.headline || page.title || (page.content && page.content.length > 0)) {
    el += partial('_partial/main/navbar/article_banner')
  }
  el += `<article class="${articleClass()}">`
  if (page.content && String(page.content).trim().length > 0) {
    el += page.content
  } else {
    // wiki 项目首页正文为空（剪裁空白后）且配置了 repo 时，
    // 以该仓库 README.md 作为主页正文（应用层 helper，复用底层远程 md 渲染组件）
    el += wiki_readme_html(theme.wiki.tree[collection_id(page, "wiki")], page)
  }
  if (notebook) {
    el += partial('_partial/main/notebook/note_tags', { notebook: notebook })
  }
  el += `</article>`
  if (layout === 'post' || collection_id(page, "wiki") || notebook) {
    if (layout === 'post' && stellar_config('content.article.showTags')) {
      el += partial('_partial/main/article/article_tags')
    }
    el += partial('_partial/main/article/article_footer')
  }
  if (layout === 'post' || collection_id(page, "wiki")) {
    el += partial('_partial/main/article/read_next')
  }
  if (layout === 'post') {
    el += partial('_partial/main/article/related_posts')
  }
  el += partial('_partial/comments/layout')
  return el
}
%>

<%- layoutDiv() %>
