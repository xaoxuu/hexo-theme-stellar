<%
page.robots = 'none';
%>
<article class='md-text error-page'>
  <% var errorImage = stellar_config('errorPage.image') %>
  <% if (errorImage) { %>
    <h1><img id='error' src='<%- errorImage %>' alt='404'></h1>
  <% } %>
  <p class='what'>
    <strong>
      <%- __('page.error.what') %>
    </strong>
  </p>
  <p class='why'>
    <%- __('page.error.why') %>
  </p>
  <br><br>
  <a class='button' id='back' href="<%- config.root %>"><%- __('page.error.action') %></a>
</article>
