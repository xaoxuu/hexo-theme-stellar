<%
const proj = theme.wiki.tree[collection_id(page, "wiki")]
const projectComments = proj?.comments || {}
const pageComments = page.comments || {}
const settings = Object.assign({}, projectComments, pageComments)
var cmt = {
  service: settings.service || theme.comments.service
}
if (cmt.service) {
  cmt[cmt.service] = Object.assign({}, theme.comments[cmt.service], projectComments[cmt.service], pageComments[cmt.service])
}
const loadComment = settings.enabled !== false && cmt.service?.length > 0
page.cmt = cmt
page.cmt_rendered = loadComment
%>
<% if (loadComment) { %>
  <div class="related-wrap md-text<%- scrollreveal(' ') %>" id="comments">
    <section class='header cmt-title cap theme'>
      <%- markdown(settings.title || theme.comments.comment_title) %>
    </section>
    <section class='body cmt-body <%- cmt.service %>'>
      <%- partial(cmt.service + '/layout') %>
    </section>
  </div>
<% } %>
