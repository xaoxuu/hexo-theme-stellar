<%
var explicitComments = typeof comments !== 'undefined' ? comments : null
var commentModel

if (explicitComments) {
  commentModel = explicitComments
} else {
  var proj = stellar_data('wiki').tree[collection_id(page, "wiki")]
  var projectComments = proj?.comments || {}
  var pageComments = content_config(page).comments || page.comments || {}
  var settings = Object.assign({}, projectComments, pageComments)
  var commentConfig = stellar_config('extensions.comments')
  var service = settings.provider || commentConfig.provider || ''
  commentModel = {
    enabled: settings.enabled !== false && service.length > 0,
    title: settings.title || commentConfig.title || '',
    id: settings.id || '',
    service: service,
    options: service
      ? Object.assign({}, commentConfig.providers[service], projectComments.options, pageComments.options)
      : {},
    pageTitle: page.title || ''
  }
  page.cmt = {service: service}
  if (service) page.cmt[service] = commentModel.options
  page.cmt_rendered = commentModel.enabled
}
%>
<% if (commentModel.enabled) { %>
  <div class="related-wrap md-text<%- scrollreveal(' ') %>" id="comments">
    <section class="header cmt-title cap theme">
      <%- markdown(commentModel.title || __('btn.comments')) %>
    </section>
    <section class="body cmt-body <%- commentModel.service %>">
      <%- partial(commentModel.service + '/layout', {comments: commentModel}) %>
    </section>
  </div>
<% } %>
