<%
function layoutDiv() {
  var el = '';
  el += '<div id="twikoo_container" class="with-fancybox"';
  let cfg = {};
  const explicit = typeof comments !== 'undefined' ? comments : null
  const commentId = explicit ? explicit.id : page.comments?.id
  if (commentId) {
    cfg['comment_id'] = commentId;
  }
  for (let key of Object.keys(cfg)) {
    if (cfg[key]) {
      el += ' ' + key + '="' + cfg[key] + '"';
    }
  }
  el += '><div class="lazy-icon"></div></div>'
  return el;
}
%>

<%- layoutDiv() %>
