<%
var commentOptions = comments.options
%>
<script type="module">
  import { init } from '<%- extension_assets().comments.waline.js %>';

  
  function initWaline() {
    const el = document.getElementById('waline_container');
    if (!el) return;

    function load_waline() {
      utils.css('<%- url_for('/css/comments/waline.css') %>?v=<%- stellar_info('version') %>');
      utils.css('<%- extension_assets().comments.waline.css %>');
      utils.css('<%- extension_assets().comments.waline.metaCss %>');

      const path = el.getAttribute('comment_id') ?? decodeURI(window.location.pathname);
      const waline = init(Object.assign(<%- JSON.stringify(commentOptions) %>, {
        el: '#waline_container',
        path: path,
        <% if(!!commentOptions.imageUploader?.api){ %>
          imageUploader: function(file) {
            const headers = new Headers();
            headers.set('Accept', 'application/json');
            <% if(!!commentOptions.imageUploader?.token) { %>
              headers.set('<%= commentOptions.imageUploader?.tokenName %>', '<%= commentOptions.imageUploader?.token %>')
            <% } %>
            const formData = new FormData();
            formData.append('<%= commentOptions.imageUploader?.fileName %>', file);
            return fetch('<%= commentOptions.imageUploader?.api %>',{
              method: 'POST',
              body: formData,
              headers: headers
              }).then((resp) => resp.json())
                .then((resp) => resp.<%= commentOptions.imageUploader?.resp %>)
          },
        <% } %>
      }));
    }
    
    util.viewportLazyload(el, load_waline);
  }
  
  // Initialize on page load
  initWaline();
</script>
