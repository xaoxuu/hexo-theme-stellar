<%
function layoutDiv() {
  var el = '';
  const cmt = comments;
  if (cmt?.service?.length > 0) {
    const name = cmt.service;
    var body = Object.assign({}, cmt.options);
    el += '<div id="' + name + '"';
    for (let key of Object.keys(body)) {
      if (body[key] !== null) {
        el += ' ' + key + '="' + body[key] + '"';
      }
    }
    el += '></div>';
  }
  return el;
}
%>

<div class="lazy-icon"></div>

<%- layoutDiv() %>
