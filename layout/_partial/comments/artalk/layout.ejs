<%
function layoutDiv() {
  var el = '';
  el += `<div class="artalk with-fancybox" id="artalk_container"`;
  let cfg = {};
  if (page.comments?.id) {
    cfg['comment_id'] = page.comments.id;
  }
  for (let key of Object.keys(cfg)) {
    if (cfg[key]) {
      el += ' ' + key + '="' + cfg[key] + '"';
    }
  }
  el += '><div class="lazy-icon"></div></div>'
  return el;
}
%>

<%- layoutDiv() %>
