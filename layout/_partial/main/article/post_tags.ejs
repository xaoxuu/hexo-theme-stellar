<%
function layoutDiv() {
  if (!Array.isArray(tags) || tags.length === 0) return ''
  var el = `<div class="article-tags${scrollreveal(' ')}">`
  tags.forEach(function(tag) {
    el += `<a class="tag" href="${pretty_url(tag.path)}">${icon('default:hashtag')}${escape_html(tag.name)}</a>`
  })
  el += '</div>'
  return el
}
%>
<%- layoutDiv() %>
