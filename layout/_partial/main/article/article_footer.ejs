<%
function layoutDiv() {
  var el = '';
  var item = [];
  var pageConfig = content_config(page)
  var articleFooter = stellar_config('content.article.footer')
  if (pageConfig.footer?.references?.length > 0) {
    item.push('references');
  }
  if (typeof articleFooter.license === 'string' && articleFooter.license.length > 0) {
    item.push('license');
  }
  if (Array.isArray(articleFooter.share) && articleFooter.share.length > 0) {
    item.push('share');
  }
  var contributors = partial('contributors', {map: theme.data_services.contributors.edit_this_page})
  if (contributors?.trim().length > 0) {
    item.push('contributors')
  }
  if (item.length === 0) {
    return el;
  }
  el += `<div class="article-footer${scrollreveal(' ')}">`
  if (pageConfig.footer?.references?.length > 0) {
    function refList() {
      var el = '';
      for (let ref of pageConfig.footer.references) {
        el += `
        <li class="post-title">
          ${markdown(ref)}
        </li>
        `
      }
      return el;
    }
    el += `
    <section id="references">
      <div class="header"><span>${__('meta.references')}</span></div>
      <div class="body">
        <ul>${refList()}</ul>
      </div>
    </section>
    `
  }

  var license = ''
  if (collection_id(page, "wiki")) {
    const proj = theme.wiki.tree[collection_id(page, "wiki")]
    if (pageConfig.footer?.license != null) {
      license = pageConfig.footer.license || articleFooter.license
    } else if (proj?.footer?.license != null) {
      if (proj.footer.license == true) {
        license = articleFooter.license
      } else {
        license = proj.footer.license
      }
    }
  } else if (page.layout == 'post') {
    if (articleFooter.license && (pageConfig.footer?.license != false)) {
      license = pageConfig.footer?.license || articleFooter.license
    }
  } else if (pageConfig.footer?.license) {
    license = pageConfig.footer.license === true ? articleFooter.license : pageConfig.footer.license
  }
  if (license?.length > 0) {
    var author = null
    if (theme.authors) {
      if (pageConfig.article?.author?.length > 0 && theme.authors[pageConfig.article.author] != null) {
        author = theme.authors[pageConfig.article.author]
      } else {
        author = theme.default_author
      }
    }
    if (author) {
      license = license.replace('{author.name}', author.name).replace('{author.url}', author.url)
    }
    el += `
    <section id="license">
      <div class="header"><span>${__('meta.license')}</span></div>
      <div class="body">${markdown(license)}</div>
    </section>
    `
  }

  if (contributors) {
    el += contributors
  }

  var showSharePlugin = false
  if (collection_id(page, "wiki")) {
    const proj = theme.wiki.tree[collection_id(page, "wiki")]
    if (pageConfig.footer?.share != null) {
      showSharePlugin = pageConfig.footer.share == true
    } else if (proj != null) {
      showSharePlugin = proj.footer?.share == true
    }
  } else if (page.layout == 'post') {
    showSharePlugin = pageConfig.footer?.share != false
  } else if (pageConfig.footer?.share) {
    showSharePlugin = true
  }
  if (Array.isArray(articleFooter.share) && showSharePlugin) {
    function urlenc(v) {
      return encodeURIComponent(v == null ? '' : String(v))
    }
    function socialButtons() {
      var el = ''
      articleFooter.share.forEach((item, i) => {
        if (['wechat', 'weibo', 'email', 'link'].includes(item)) {
          el += '<a class="social share-item ' + item + '"';
          if (item == 'weibo') {
            el += ' target="_blank" rel="external nofollow noopener noreferrer"';
          }
          if (item == 'wechat') {
            el += ' onclick="util.toggle(&quot;qrcode-wechat&quot;)"';
          } else if (item == 'weibo') {
            el += ' href="https://service.weibo.com/share/share.php?url=' + urlenc(page.permalink);
            el += '&title=' + urlenc(page.title + ' - ' + config.title);
            if (pageConfig.card?.cover) {
              el += '&pics=' + urlenc(pageConfig.card.cover);
            } else if (collection_id(page, "wiki")) {
              const projectCover = theme.wiki.tree[collection_id(page, "wiki")]?.card?.cover
              if (projectCover) el += '&pics=' + urlenc(projectCover)
            }
            el += '&summary=' + urlenc(truncate(page.description || strip_html(page.excerpt || page.content), {length: 120}));
            el += '"';
          } else if (item == 'email') {
            el += ' href="mailto:?subject=' + urlenc(page.title + ' - ' + config.title) + '&amp;'
            el += 'body=' + urlenc(page.permalink) + '"';
          } else if (item == 'link') {
            el += ' onclick="util.copy(&quot;copy-link&quot;, &quot;' + escape_html(__('message.copied')) + '&quot;)"';
          }
          el += '>';
          el += icon(`share:${item}`)
          el += '</a>';
        }
      });
      return el;
    }
    function qrcode() {
      if (articleFooter.share.includes('wechat')) {
        return `
        <div class="qrcode" id="qrcode-wechat" style="opacity:0;height:0">
          <img src="https://api.qrserver.com/v1/create-qr-code/?size=256x256&data=${urlenc(page.permalink)}"/>
        </div>
        `
      } else {
        return ''
      }
    }
    el += `
    <section id="share">
      <div class="header"><span>${__('meta.share')}</span></div>
      <div class="body">
        <div class="link"><input class="copy-area" readonly="true" id="copy-link" value="${escape_html(page.permalink)}" /></div>
        <div class="social-wrap dis-select">${socialButtons()}</div>
        ${qrcode()}
      </div>
    </section>
    `
  }

  el += '</div>';
  return el;
}
%>
<%- layoutDiv(); %>
