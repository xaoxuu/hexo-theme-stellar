<%
// 置顶内容轮播：所有带 Listing Nav 的列表页上方共用，关闭导航时仍独立渲染。
// type: post / wiki / topic
var pinType = type || 'post'
var pinItems = []

function pinValue(item) {
  if (['post', 'topic'].includes(item?.collection?.profile)) return item.render.listing.priority
  if (pinType == 'wiki' && item?.id && item?.href) return item.priority
  return item.listing?.priority
}

function isPinned(item) {
  return pinValue(item) > 0
}

function pinWeight(item) {
  var n = Number(pinValue(item))
  return isNaN(n) ? 0 : n
}

if (pinType == 'wiki') {
  if (!Array.isArray(wikiItems)) {
    throw new Error('Stellar v2: Wiki 置顶列表缺少显式 render.listing')
  }
  for (var wi = 0; wi < wikiItems.length; wi++) {
    var wproj = wikiItems[wi]
    if (wproj.listed && isPinned(wproj)) {
      pinItems.push(wproj)
    }
  }
} else {
  var allPosts = site.posts.toArray() || []
  for (var pi = 0; pi < allPosts.length; pi++) {
    var post = allPosts[pi]
    var viewModel = post_view_model(post)
    if (!['post', 'topic'].includes(viewModel?.collection?.profile) || !viewModel.render?.listing) {
      throw new Error(`Stellar v2: Post ${post?.source || post?.path || '<unknown>'} 缺少置顶列表 ViewModel`)
    }
    if (!viewModel.render.listing.listed) continue
    if (isPinned(viewModel)) {
      pinItems.push(viewModel)
    }
  }
}

pinItems.sort(function(a, b) {
  return pinWeight(b) - pinWeight(a)
})

// 文章幻灯片：固定「标题 + 一行小字」结构。
// 标题：post.title；小字由 caption() helper 统一取值。
// 样式与 hero 卡片 cover-info 一致；无封面时为纯白卡片（文字按普通文章颜色）。
function postSlide(viewModel) {
  var post = viewModel.render.listing
  var cover = post.cover
  var noCover = !(cover != null && cover.length > 0)
  var headline = post.title
  var sub = post.caption
  var el = ''
  el += '<a class="pin-slide post-slide' + (noCover ? ' no-cover' : '') + '" href="' + escape_html(pretty_url(post.href)) + '"'
  if (!noCover) {
    el += ' style="--pin-cover-url:url(\'' + escape_html(cover.replace(/'/g, '%27')) + '\')"'
  }
  el += '>'
  if (!noCover) {
    el += '<img class="pin-slide-bg" src="' + escape_html(cover) + '" alt=""/>'
  }
  // 有封面时文字颜色自适应（大字 contrast、小字 theme）；无封面保持普通文章文字颜色
  el += '<div class="pin-slide-text"' + (noCover ? '' : ' data-text-adaptive="split"') + '>'
  el += '<div class="pin-slide-headline">' + escape_html(headline) + '</div>'
  if (sub.length > 0) {
    el += '<div class="pin-slide-caption">' + escape_html(sub) + '</div>'
  }
  el += '</div>'
  el += '</a>'
  return el
}

function projectChips(tags) {
  var caps = ''
  if (tags && tags.length > 0) {
    caps += '<span class="pin-slide-chip">' + tags.map(function(t) { return escape_html(t) }).join('</span><span class="pin-slide-chip">') + '</span>'
  }
  return caps
}

function wikiSlide(proj) {
  var img = proj.cover
  var title = proj.headline || proj.name || proj.id
  var excerpt = proj.description || ''
  var el = ''
  el += '<a class="pin-slide' + (img ? '' : ' no-cover') + '" href="' + escape_html(pretty_url(proj.href || '/')) + '"'
  if (img) {
    el += ' style="--pin-cover-url:url(\'' + escape_html(img.replace(/'/g, '%27')) + '\')"'
  }
  el += '>'
  if (img) {
    el += '<img class="pin-slide-bg" src="' + escape_html(img) + '" alt=""/>'
  }
  el += '<div class="pin-slide-info"' + (img ? ' data-text-adaptive="split"' : '') + '>'
  el += '<div class="pin-slide-caps">' + projectChips(proj.tags) + '</div>'
  el += '<div class="pin-slide-title">' + escape_html(title) + '</div>'
  if (excerpt.length > 0) {
    el += '<div class="pin-slide-excerpt">' + escape_html(excerpt) + '</div>'
  }
  el += '</div>'
  el += '</a>'
  return el
}

if (pinItems.length > 0) {
  var slidesHtml = ''
  var dotsHtml = ''
  for (var si = 0; si < pinItems.length; si++) {
    var item = pinItems[si]
    if (pinType == 'wiki') {
      slidesHtml += wikiSlide(item)
    } else {
      slidesHtml += postSlide(item)
    }
    if (pinItems.length > 1) {
      dotsHtml += '<button type="button" class="pin-slider-dot' + (si == 0 ? ' active' : '') + '" data-index="' + si + '"></button>'
    }
  }
  var groupKey = pinType == 'wiki' ? 'wiki' : 'post'
  var sliderInterval = 5000 // 自动轮播间隔固定 5000ms
  var el = ''
  el += '<div class="' + ui_classes('pin-slider', 'hoverCard') + '" id="pin-slider" data-interval="' + sliderInterval + '" data-key="' + pinType + '" data-group="' + groupKey + '">'
  el += '<div class="pin-slider-track">'
  el += slidesHtml
  el += '</div>'
  if (dotsHtml.length > 0) {
    el += '<div class="pin-slider-dots">' + dotsHtml + '</div>'
    el += '<button type="button" class="pin-slider-nav prev">' + icon('default:arrow-left') + '</button>'
    el += '<button type="button" class="pin-slider-nav next">' + icon('default:arrow-right') + '</button>'
  }
  el += '</div>'
%>
<%- el %>
<%
}
%>
