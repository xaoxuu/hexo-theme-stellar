<%
function layoutDiv() {
  var pageConfig = content_config(page);
  var repo = pageConfig.source?.repository || stellar_data('wiki').tree[collection_id(page, "wiki")]?.source?.repository
  if (repo == null) {
    return ''
  }
  return `
  <div class="right ghrepo data-service data-service ds-ghinfo" data-api="${stellar_config('services.github.apiUrl')}/repos/${repo}">
    <a class="repo-link bold" href="https://github.com/${repo}">
      ${icon('github:repo')}
      <span type="text">${repo}</span>
    </a>
    <a class="repo-link" href="https://github.com/${repo}/stargazers">
      ${icon('github:star')}
      <span type="text" id="stargazers_count">0</span><span>stars</span>
    </a>
    <a class="repo-link" href="https://github.com/${repo}/forks">
      ${icon('github:fork')}
      <span type="text" id="forks_count">0</span><span>forks</span>
    </a>
  </div>
  `
}
%>
<%- layoutDiv() %>
