<%

var banner = {}

if (page.banner) {
  banner.url = page.banner
} else if (theme.topic.tree[page.topic]?.banner != null) {
  banner.url = theme.topic.tree[page.topic]?.banner
} else if (theme.wiki.tree[page.wiki]?.banner != null) {
  banner.url = theme.wiki.tree[page.wiki]?.banner
}
banner = Object.assign(banner, page.banner_info)
// 标题
if (banner.title == null) {
  banner.title = page.h1 != null ? page.h1 : page.title
}
// 副标题
if (banner.subtitle == null) {
  banner.subtitle = page.subtitle
}

// 上块：第一行（左侧面包屑 + 右侧阅读时长 / AI 标签）+ 第二行（日期信息，靠左）
function layoutTop() {
  if (page.breadcrumb === false) {
    return ''
  }
  var el = ''
  // 1.上块容器
  el += `<div class="top bread-nav footnote">`
  // 2.第一行
  el += `<div class="top-row">`
  // 2.1 左：面包屑导航
  el += `<div class="left" id="breadcrumb">`
    // 首页
    el += `<a class="cap breadcrumb" href="${pretty_url(config.root)}">${__("btn.home")}</a>`
    if (theme.wiki.tree[page.wiki]) {
      el += partial('breadcrumb/wiki')
    } else if (page.notebook) {
      el += partial('breadcrumb/note')
    } else if (page.layout == 'post') {
      el += partial('breadcrumb/blog')
    } else {
      el += partial('breadcrumb/page')
    }
  el += `</div>`
  // 2.2 右：字数和预计阅读时长 + AI 成分标签（仅在有内容时渲染）
  var rightHtml = ''
  // 字数和预计阅读时长，置于第一行右侧（#302）
  if (page.layout == 'post' && theme.article.reading_time) {
    var _wc = word_count(page)
    if (_wc > 0) {
      rightHtml += `<span class="cap reading">${__("meta.word_count", _wc)} · ${__("meta.reading_time", reading_time(page))}</span>`
    }
  }
  // AI 成分标签：置于第一行最右（阅读时长右侧）；
  // banner 含图片时不用配置色，继承默认文字色（--text-banner）
  const bannerHasImage = banner.url && banner.url.length > 0
  rightHtml += ai_label(page.ai_label, 'cap', bannerHasImage)
  if (rightHtml.length > 0) {
    el += `<div class="right">${rightHtml}</div>`
  }
  // end 2.第一行
  el += `</div>`
  // 3.第二行：日期信息，靠左
  el += `<div class="meta-row">`
  el += partial('dateinfo')
  el += `</div>`
  // end 1.上块
  el += `</div>`
  return el
}

function layoutTitle() {
  if (banner.title?.length > 0) {
    return `<h1 class="text title"><span>${banner.title}</span></h1>`
  } else {
    return ''
  }
}

function layoutSubtitle() {
  if (banner.subtitle?.length > 0) {
    return `<div class="text subtitle">${banner.subtitle}</div>`
  } else {
    return ''
  }
}

function layoutIcon() {
  if (banner.avatar?.length > 0 || banner.icon?.length > 0) {
    return `<img class="lazy avatar" data-src="${banner.avatar || banner.icon}">`
  } else {
    return ''
  }
}

function layoutBottom() {
  const el_icon = layoutIcon()
  const el_title = layoutTitle()
  const el_subtitle = layoutSubtitle()
  var cls = ''
  if (el_title.length > 0 && el_subtitle.length == 0) {
    cls += ' only-title'
  }
  if (el_title.length > 0) {
    return `
    <div class="bottom${cls}">
      ${el_icon}
      <div class="text-area">
        ${el_title}
        ${el_subtitle}
      </div>
    </div>
    `
  } else {
    return ``
  }
}

function layoutDiv() {
  const bottom = layoutBottom()
  const top = layoutTop()
  if (top.length == 0 && bottom.length == 0) {
    return ``
  }
  var bannerStyle = ``
  var adaptiveAttr = ``
  var maskHtml = ``
  var el = ``
  if (banner.url?.length > 0) {
    bannerStyle += ` style="--bg-url:url('${banner.url.replace(/'/g, '%27')}')"`
    // 背景图上方文字颜色自适应
    adaptiveAttr = ` data-text-adaptive="split"`
  }
  el += `<div class="article-banner-wrap${scrollreveal(' ')}">`
  el += `<div class="article banner top"${bannerStyle}>`
  if (banner.url?.length > 0) {
    el += `<img class="lazy bg" data-src="${banner.url}">`
    maskHtml = `<div class="banner-mask banner-mask-top" aria-hidden="true"></div><div class="banner-mask banner-mask-bottom" aria-hidden="true"></div>`
  }
  el += `
  <div class="content"${adaptiveAttr}>
    ${maskHtml}
    ${top}
    ${bottom}
  </div>
  `
  el += `</div>`
  el += `</div>`
  return el
}
%>
<%- layoutDiv() %>
