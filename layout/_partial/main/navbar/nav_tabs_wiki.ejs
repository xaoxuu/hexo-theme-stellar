<%
function layoutDiv() {
  if (!wikiIndex || !Array.isArray(wikiIndex.items) || !Array.isArray(wikiIndex.allItems) || !Array.isArray(wikiIndex.tags)) {
    throw new Error('Stellar v2: Wiki tabs 缺少显式索引投影')
  }
  var el = '';
  el += partial('_partial/main/pin_slider', {type: 'wiki', wikiItems: wikiIndex.allItems});
  el += '<div class="navbar top">';
  el += '<div class="navbar-blur">';
    el += '<div class="navbar-container">';
  el += '<nav class="wiki">';
  // 所有项目
  el += '<a';
  if (wikiIndex.filter === false) {
    el += ' class="active"';
  }
  el += ' href="' + pretty_url(wikiIndex.path) + '">' + __("btn.all_wiki") + '</a>';
  el += '</a>';
  // 项目分类
  for (var tag of wikiIndex.tags) {
    var projects = tag.itemIds.filter(id => wikiIndex.allItems.some(item => item.id === id))
    if (projects.length > 0) {
      el += '<a';
      if (tag.name && tag.name.length > 0 && wikiIndex.tagName === tag.name) {
        el += ' class="active"';
      }
      el += ' href="' + escape_html(pretty_url(tag.path)) + '">' + escape_html(tag.name) + '</a>';
      el += '</a>';
    }
  }

  var nav_tabs = stellar_config('layout.profiles.wikiIndex.navigation.tabs')
  if (nav_tabs) {
    for (let key of Object.keys(nav_tabs)) {
      // 当 page 的末尾为 index.html 或者处于该 page 的某个子页面时也应该匹配
      // if (full_url_for(page.path) == full_url_for(nav_tabs[key])) {
      if (full_url_for(page.path).startsWith(full_url_for(nav_tabs[key]))){
        el += '<a class="active" href="' + url_for(nav_tabs[key]) + '">' + key + '</a>';
      } else {
        el += '<a href="' + url_for(nav_tabs[key]) + '">' + key + '</a>';
      }
    }
  }

  el += '</nav>';
  el += '</div>';
  el += '</div>';
  el += '</div>';
  return el;
}
%>

<%- layoutDiv() %>
