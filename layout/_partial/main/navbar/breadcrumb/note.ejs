<%# 笔记页面的面包屑 %>
<span class="sep"></span>
<a class="cap breadcrumb" href="<%= pretty_url(stellar_config('layout.profiles.notebookIndex.path')) %>"><%= __('btn.notebook') %></a>
<% var notebook = stellar_data('notebooks').tree[collection_id(page, "notebook")] %>
<% if (notebook) { %>
  <span class="sep"></span>
  <a class="cap breadcrumb" href="<%= pretty_url(notebook.route.path) %>"><%= notebook.headline || notebook.name %></a>
<% } %>
