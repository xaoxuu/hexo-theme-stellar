<%
function layoutDiv() {
  var postViewModel = typeof viewModel !== 'undefined' && ['post', 'topic'].includes(viewModel?.collection?.profile)
    ? viewModel
    : null
  if (postViewModel) {
    var postHtml = ''
    postHtml += `<span class="sep"></span>`
    var isTopic = postViewModel.collection.profile === 'topic'
    postHtml += `<a class="cap breadcrumb"${isTopic ? ' id="menu"' : ''} href="${pretty_url(postViewModel.render.layout.blogPath)}">${__(isTopic ? "btn.topic" : "btn.blog")}</a>`
    for (var breadcrumb of postViewModel.render.layout.breadcrumbs) {
      if (isTopic && pretty_url(breadcrumb.path) == pretty_url(postViewModel.render.layout.blogPath)) continue
      postHtml += `<span class="sep"></span>`
      postHtml += `<a class="cap ${isTopic ? 'breadcrumb' : 'breadcrumb-link'}"${isTopic ? ' id="proj"' : ''} href="${pretty_url(breadcrumb.path)}">${escape_html(breadcrumb.name)}</a>`
    }
    return postHtml
  }
  var topicObject = stellar_data('topic').tree[collection_id(page, "topic")]
  var el = ''
  if (topicObject) { // 专栏文章
    // 专栏列表页
    var topicIndexPageURL = pretty_url(stellar_config('layout.profiles.topicIndex.path'))
    el += `<span class="sep"></span>`
    el += `<a class="cap breadcrumb" id="menu" href="${topicIndexPageURL}">${__("btn.topic")}</a>`
    // 专栏项目名
    const topicHomePageURL = pretty_url(topicObject.homepage?.path);
    if (topicHomePageURL != topicIndexPageURL) {
      el += `<span class="sep"></span>`
      el += `<a class="cap breadcrumb" id="proj" href="${topicHomePageURL}">${topicObject.name || topicObject.title}</a>`
    }
  } else { // 普通文章
    // 文章列表页
    el += `<span class="sep"></span>`
    el += `<a class="cap breadcrumb" href="${pretty_url(config.index_generator.path)}">${__("btn.blog")}</a>`
    // 分类列表页
    if (page.categories?.length > 0) {
      el += `<span class="sep"></span>`
      el += list_categories(page.categories, {
          class: "cap breadcrumb",
          show_count: false,
          separator: ' <span class="sep"></span> ',
          style: "none"
        })
    }
  }
  return el
}
%>
<%- layoutDiv() %>
