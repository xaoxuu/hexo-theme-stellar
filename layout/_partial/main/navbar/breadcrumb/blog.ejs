<%
function layoutDiv() {
  const postViewModel = typeof viewModel !== 'undefined' && viewModel?.collection?.profile === 'post'
    ? viewModel
    : null
  if (postViewModel) {
    var postHtml = ''
    postHtml += `<span class="sep"></span>`
    postHtml += `<a class="cap breadcrumb" href="${pretty_url(postViewModel.render.layout.blogPath)}">${__("btn.blog")}</a>`
    for (var breadcrumb of postViewModel.render.layout.breadcrumbs) {
      postHtml += `<span class="sep"></span>`
      postHtml += `<a class="cap breadcrumb-link" href="${pretty_url(breadcrumb.path)}">${escape_html(breadcrumb.name)}</a>`
    }
    return postHtml
  }
  const topicObject = theme.topic.tree[collection_id(page, "topic")]
  var el = ''
  if (topicObject) { // 专栏文章
    // 专栏列表页
    const topicIndexPageURL = pretty_url(theme.site_tree.index_topic.base_dir)
    el += `<span class="sep"></span>`
    el += `<a class="cap breadcrumb" id="menu" href="${topicIndexPageURL}">${__("btn.topic")}</a>`
    // 专栏项目名
    const topicHomePageURL = pretty_url(topicObject.homepage?.path);
    if (topicHomePageURL != topicIndexPageURL) {
      el += `<span class="sep"></span>`
      el += `<a class="cap breadcrumb" id="proj" href="${topicHomePageURL}">${topicObject.name || topicObject.title}</a>`
    }
  } else { // 普通文章
    // 文章列表页
    el += `<span class="sep"></span>`
    el += `<a class="cap breadcrumb" href="${pretty_url(config.index_generator.path)}">${__("btn.blog")}</a>`
    // 分类列表页
    if (page.categories?.length > 0) {
      el += `<span class="sep"></span>`
      el += list_categories(page.categories, {
          class: "cap breadcrumb",
          show_count: false,
          separator: ' <span class="sep"></span> ',
          style: "none"
        })
    }
  }
  return el
}
%>
<%- layoutDiv() %>
