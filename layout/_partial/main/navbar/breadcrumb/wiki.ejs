<%
function layoutDiv() {
  var wikiViewModel = typeof viewModel !== 'undefined' && viewModel?.collection?.profile === 'wiki'
    ? viewModel
    : null
  if (wikiViewModel) {
    var render = wikiViewModel.render.layout
    var el = `<span class="sep"></span>`
    el += `<a class="cap breadcrumb" id="menu" href="${pretty_url(render.wikiIndexPath)}">${__("btn.wiki")}</a>`
    for (var breadcrumb of render.breadcrumbs) {
      if (pretty_url(breadcrumb.path) != pretty_url(render.wikiIndexPath)) {
        el += `<span class="sep"></span>`
        el += `<a class="cap breadcrumb" id="proj" href="${pretty_url(breadcrumb.path)}">${escape_html(breadcrumb.name)}</a>`
      }
    }
    return el
  }
  var wikiObject = stellar_data('wiki').tree[collection_id(page, "wiki")]
  var el = ''
  // 文档列表页
  el += `<span class="sep"></span>`
  var wikiIndexPageURL = pretty_url(stellar_config('profiles.wikiIndex.path'))
  el += `<a class="cap breadcrumb" id="menu" href="${wikiIndexPageURL}">${__("btn.wiki")}</a>`
  if (wikiObject) {
    // 文档项目名
    const wikiHomePageURL = pretty_url(wikiObject.homepage?.path);
    if (wikiHomePageURL != wikiIndexPageURL) {
      el += `<span class="sep"></span>`
      el += `<a class="cap breadcrumb" id="proj" href="${wikiHomePageURL}">${wikiObject.name || wikiObject.title}</a>`
    }
  }
  return el
}
%>
<%- layoutDiv() %>
