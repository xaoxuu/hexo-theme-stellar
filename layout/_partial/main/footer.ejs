<%
var siteFooter = stellar_config('site.footer')
var content = siteFooter.content?.replace('{author.name}', (config.author || 'Anonymity'))?.replace('{theme.name}', stellar_info('name'))?.replace('{theme.version}', stellar_info('version'))?.replace('{theme.tree}', stellar_info('tree'))
function layoutDiv() {
  var el = ''
  el += `<footer class="page-footer${scrollreveal(' ')} footnote">`
  el += '<hr>'
  // sitemap
  var sections = siteFooter.sections
  if (sections.length > 0) {
    var count = sections.length
    if ([6].includes(count)) {
      count = 3
    } else if ([7,8].includes(count)) {
      count = 4
    } else {
      count = Math.min(sections.length, 5)
    }
    el += `<div class="sitemap" style="column-count:${count};">`
    for (var group of sections) {
      var title = escape_html(group.title)
      var items = group.items
      if (items == undefined || items.length == 0) {
        continue
      }
      el += '<div class="sitemap-group">'
      el += '<span class="fs15">' + title + '</span>'
      items.forEach((item, i) => {
        el += '<a href="' + escape_html(url_for(item.url)) + '">'
        el += escape_html(__(item.title))
        el += '</a>'
      });
      el += '</div>'
    }
    el += '</div>'
  }
  // footer
  el += '<div class="text">'
  if (content) {
    el += markdown(content)
  }
  el += '</div></footer>'
  return el
}
%>
<%- layoutDiv() %>
