<%
function layoutDiv() {
  var el = '';
  if (!listing || typeof listing !== 'object') {
    throw new Error('Stellar v2: Wiki 卡片缺少显式 render.listing')
  }
  var cover = listing.cover;
  var projectIcon = listing.icon;
  var caption = listing.caption;
  var headline = listing.headline || listing.name;
  el += '<article class="wiki-card-content">';
  el += '<div class="wiki-card-cover' + (cover ? '' : ' no-cover') + '" position="bottom"';
  if (cover) {
    el += ' style="--cover-url:url(\'' + escape_html(cover.replace(/'/g, '%27')) + '\')">';
    el += '<img src="' + escape_html(cover) + '" alt=""/>';
  } else {
    el += '>';
  }
  el += '<div class="wiki-card-info" position="bottom"';
  if (cover) {
    el += ' data-text-adaptive="split"';
  }
  el += '>';
  el += '<div class="wiki-card-summary">';
  if (listing.tags && listing.tags.length > 0) {
    el += '<div class="wiki-tags wiki-meta">';
    for (var i = 0; i < listing.tags.length; i++) {
      var tag = listing.tags[i];
      el += '<span>' + escape_html(tag) + '</span>';
    }
    el += '</div>';
  }
  el += '<h2 class="headline">' + escape_html(headline) + '</h2>';
  if (listing.audience || listing.repository) {
    el += '<div class="wiki-meta">';
    if (listing.audience) {
      el += '<span class="wiki-available">' + icon('default:platforms') + '<span class="label">' + escape_html(__('meta.available')) + '</span><span class="value">' + escape_html(listing.audience) + '</span></span>';
    }
    if (listing.repository) {
      el += '<span class="wiki-stars data-service ds-ghinfo" data-api="' + escape_html(listing.repositoryApi) + '">';
      el += icon('default:fire') + '<span type="text" id="stargazers_count"></span>';
      el += '</span>';
    }
    el += '</div>';
  }
  el += '</div>';
  el += '<div class="wiki-project">';
  el += '<div class="project-icon">';
  if (projectIcon) {
    el += '<img src="' + escape_html(projectIcon) + '" alt=""/>';
  } else {
    el += icon('default:documents');
  }
  el += '</div>';
  el += '<div class="project-text"><div class="project-name">' + escape_html(listing.name || '') + '</div>';
  if (caption.length > 0) {
    el += '<div class="project-subtitle">' + escape_html(caption) + '</div>';
  }
  el += '</div></div>';
  el += '</div></div>';
  el += '</article>';
  return el;
}
%>
<%- layoutDiv() %>
