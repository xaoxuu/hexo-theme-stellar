<%
var postViewModel = typeof post === 'undefined' && typeof viewModel !== 'undefined' ? viewModel : null
if (postViewModel && (!['post', 'topic'].includes(postViewModel.collection?.profile) || !postViewModel.render?.listing)) {
  throw new Error('Stellar v2: 归档条目缺少合法 PageViewModel.render.listing')
}
var item = postViewModel ? postViewModel.render.listing : (typeof post !== 'undefined' ? post : {})
var href = pretty_url(postViewModel ? (item.href || '/') : (item.link || item.path || '/'))
var itemDate = item.date ? date(item.date, 'MM-DD') : ''
var itemTitle = item.title || (item.date ? date(item.date, config.date_format) : '')
%>
<div class="archive-list">
  <a class="post fs14" href="<%- escape_html(href) %>">
    <% if (itemDate) { %><time><%- escape_html(itemDate) %></time><% } %>
    <span><%- escape_html(itemTitle) %></span>
  </a>
</div>
