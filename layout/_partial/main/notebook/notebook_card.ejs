<%# 笔记本信息卡片 %>
<% var listing = render.listing %>
<article class="md-text">
  <div class="preview">
    <% if (listing.icon) { %>
      <img src="<%= listing.icon %>" alt="icon"/>
    <% } else { %>
      <%- icon('default:documents') %>
    <% } %>
  </div>
  <div class="excerpt">
    <h2 class="post-title"><%= listing.headline || listing.name %></h2>
    <% if (listing.description) { %>
      <p><%= listing.description %></p>
    <% } %>
  </div>
</article>
