<%
const postViewModel = typeof viewModel !== 'undefined' && viewModel?.collection?.profile === 'post'
  ? viewModel
  : null
const postRender = postViewModel?.render
var pageConfig = content_config(page)
var stellarSeo = stellar_config('seo')
var stellarResources = stellar_config('resources')

function strip_wiki_title(title, wiki) {
  if (!wiki) { return title; }
  var t = String(title || '');
  if (t.toLowerCase() === String(wiki).toLowerCase()) { return ''; }
  // wiki 名中的空格/连字符在标题中可能写为另一种形态（如 cloud shell / cloud-shell）
  var flex = String(wiki).replace(/[.*+?^${}()|[\]\\]/g, '\\$&').replace(/[\s-]+/g, '[\\s-]*');
  var m = t.match(new RegExp('^' + flex + '[\\s-]*[：:\\-](.*)$', 'i'));
  if (m && m[1]) {
    return m[1].trim();
  }
  return t;
}

function generate_title() {
  if (postRender) {
    return postRender.seo.title
  } else if (collection_id(page, "wiki")) {
    var proj = stellar_data('wiki').tree[collection_id(page, "wiki")]
    const wiki = proj?.name || collection_id(page, "wiki")
    if (page.title) {
      var stripped = strip_wiki_title(page.title, wiki)
      if (stripped) {
        return wiki + __('symbol.colon') + stripped + ' - ' + config.title;
      }
    }
    return wiki + ' - ' + config.title;
  } else {
    if (page.title) {
      return page.title + ' - ' + config.title;
    } else if (page.category) {
      return __('btn.category') + __('symbol.colon') + page.category + ' - ' + config.title;
    } else if (page.tag) {
      return __('btn.tag') + __('symbol.colon') + page.tag + ' - ' + config.title;
    }
  }
  if (is_home() && page.current && page.current > 1) {
    return config.title + ' - ' + __('symbol.page', page.current);
  }
  return config.title;
}
function generate_description() {
  if (postRender) {
    if (postRender.seo.openGraph) return ''
    return '<meta name="description" content="' + escape_meta_content(postRender.seo.description) + '">'
  }
  if (stellarSeo.openGraph.enabled) {
    return '';
  }
  if (page.description) {
    return '<meta name="description" content="' + truncate(strip_html(page.description), {length: 150}) + '">';
  }
  if (collection_id(page, "wiki")) {
    var proj = stellar_data('wiki').tree[collection_id(page, "wiki")]
    if (proj?.description) {
      return '<meta name="description" content="' + proj.description + '">'
    }
  }
  if (page.excerpt || page.content) {
    return '<meta name="description" content="' + truncate(strip_html(page.excerpt || page.content), {length: 150}) + '">';
  }
  return '<meta name="description" content="' + config.description + '">';
}
function generate_keywords() {
  if (postRender) {
    return postRender.seo.keywords.length > 0
      ? '<meta name="keywords" content="' + escape_meta_content(postRender.seo.keywords.join(',')) + '">'
      : ''
  } else if (page.keywords && page.keywords.length > 0) {
    return '<meta name="keywords" content="' + page.keywords + '">';
  } else if (page.tags && page.tags.length > 0) {
    return '<meta name="keywords" content="' + page.tags.map(tag => tag.name).join(',') + '">';
  } else if (config.keywords && config.keywords.length > 0) {
    return '<meta name="keywords" content="' + config.keywords + '">';
  } else {
    return '';
  }
}

function generate_robots() {
  if (postRender) {
    return postRender.seo.robots
      ? '<meta name="robots" content="' + escape_meta_content(postRender.seo.robots) + '">'
      : ''
  }
  const IS_BACKUP = process.env.IS_BACKUP === 'true';
  if (IS_BACKUP) {
    return '<meta name="robots" content="noindex, nofollow">';
  }
  if (is_home() == true) {
    return '';
  }
  if (page.robots) {
    return '<meta name="robots" content="' + page.robots + '">';
  }
}
function og_args() {
  if (postRender) {
    return Object.assign({}, postRender.seo.openGraph?.args || {})
  }
  var args = {};
  if (stellarSeo.openGraph.twitterId) {
    args.twitter_id = stellarSeo.openGraph.twitterId;
  }
  if (page.layout == 'post' && pageConfig.card?.cover) {
    args.twitter_card = 'summary_large_image';
  }
  if (collection_id(page, "wiki") && !page.description) {
    var proj = stellar_data('wiki').tree[collection_id(page, "wiki")];
    if (proj && proj.description) {
      args.description = proj.description;
    }
  }
  args.image = pageConfig.card?.cover || pageConfig.banner?.image || first_content_image(page.content) || config.avatar || (config.email ? gravatar(config.email) : null);
  return Object.assign(args, pageConfig.seo?.openGraph || {});
}

function escape_meta_content(content) {
  return String(content || '')
    .replace(/&/g, '&amp;')
    .replace(/"/g, '&quot;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

function generate_og_title() {
  return escape_meta_content(strip_html(postRender ? postRender.seo.openGraph.title : page.title || config.title));
}

function generate_og_site_name() {
  return escape_meta_content(strip_html(postRender ? postRender.seo.openGraph.siteName : config.title));
}

function generate_twitter_title() {
  return escape_meta_content(strip_html(postRender ? postRender.seo.openGraph.twitterTitle : page.title || config.title));
}

function render_open_graph() {
  if (postRender ? !postRender.seo.openGraph : !stellarSeo.openGraph.enabled) {
    return '';
  }
  let meta = open_graph(og_args());
  if (postRender) {
    meta = meta.replace(/<meta property="article:tag" content="[^"]*">\n?/g, '');
    var articleMeta = ''
    if (postRender.seo.openGraph.publishedTime) {
      articleMeta += `<meta property="article:published_time" content="${escape_meta_content(postRender.seo.openGraph.publishedTime)}">\n`
    }
    if (postRender.seo.openGraph.modifiedTime) {
      articleMeta += `<meta property="article:modified_time" content="${escape_meta_content(postRender.seo.openGraph.modifiedTime)}">\n`
    }
    for (const tag of postRender.seo.openGraph.tags) {
      articleMeta += `<meta property="article:tag" content="${escape_meta_content(tag)}">\n`
    }
    meta = meta.replace(/<meta name="twitter:card"/, `${articleMeta}<meta name="twitter:card"`)
  }
  meta = meta.replace(/<meta property="og:title" content="[^"]*">/, `<meta property="og:title" content="${generate_og_title()}">`);
  if (meta.match(/<meta property="og:site_name" content="[^"]*">/)) {
    meta = meta.replace(/<meta property="og:site_name" content="[^"]*">/, `<meta property="og:site_name" content="${generate_og_site_name()}">`);
  } else {
    meta += `<meta property="og:site_name" content="${generate_og_site_name()}">`;
  }
  if (postRender || page.title) {
    if (meta.match(/<meta name="twitter:title" content="[^"]*">/)) {
      meta = meta.replace(/<meta name="twitter:title" content="[^"]*">/, `<meta name="twitter:title" content="${generate_twitter_title()}">`);
    } else {
      meta += `<meta name="twitter:title" content="${generate_twitter_title()}">`;
    }
  }
  return meta;
}

function preconnect() {
  var el = '';
  for (var href of stellarResources.preconnect) {
    el += `<link rel="preconnect" href="${href}" crossorigin>`;
  }
  return el;
}

function custom_inject() {
  return stellar_inject('head', postRender ? postRender.document.headInject : pageConfig.inject?.head)
}

function generate_canonical() {
  if (postRender) {
    return postRender.seo.canonical
      ? `<link rel="canonical" href="${escape_meta_content(postRender.seo.canonical)}">`
      : ''
  }
  var host = stellarSeo.canonical.host;
  if (host.length > 0) {
    var path = pretty_url(page.path) || '/';
    if (path.startsWith('/404') || path.startsWith('404')) {
      return '';
    }
    return `<link rel="canonical" href="https://${host}${path}">`;
  }
  return '';
}

%>

<head>
  <meta charset="utf-8">
  <meta name="hexo-theme" content="<%- stellar_info('tree') %>" theme-name="<%- stellar_info('name') %>" theme-version="<%- stellar_info('version') %>">
  <%- generate_canonical() %>
  <%- generate_robots() %>
  <%- meta_generator() %>
  <meta http-equiv='x-dns-prefetch-control' content='on' />
  <%- preconnect() %>
  <meta name="renderer" content="webkit">
  <meta name="force-rendering" content="webkit">
  <meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1">
  <meta name="HandheldFriendly" content="True" >
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000">
  <meta name="theme-color" content="#f9fafb">
  <title><%- generate_title() %></title>

  <%- render_open_graph() %>
  <%- generate_description() %>
  
  <%- generate_keywords() %>

  <!-- feed -->
  <% if (config.feed && config.feed.path) { %>
    <%
      var paths = Array.isArray(config.feed.path)
        ? config.feed.path
        : [config.feed.path];
    %>

    <% paths.forEach(function (path) { %>
      <% if (path) { %>
        <%- feed_tag(path, { title: config.title }) %>
      <% } %>
    <% }) %>
  <% } %>

  <link rel="preload" href="<%- url_for(`${stellar_info('main_css')}?v=${stellar_info('version')}`) %>" as="style">
  <link rel="stylesheet" href="<%- url_for(`${stellar_info('main_css')}?v=${stellar_info('version')}`) %>">
  <style>:root{--text-loading:<%- JSON.stringify(__('message.loading')) %>;--text-loading-error:<%- JSON.stringify(__('message.loading_failed')) %>}</style>


  <% if (config.favicon) { %>
    <%- favicon_tag(config.favicon) %>
  <% } %>

  <% if (config.highlight && config.highlight.enable == true && config.highlight.hljs == true) { %>
    <%- css(stellar_config('appearance.codeBlock.highlightTheme')) %>
  <% } %>

  <%- json_ld(postViewModel || undefined) %>
  <%- custom_inject() %>

  <!-- icons.yml 驱动的 CSS 装饰图标 -->
  <%
    const iconCssVars = (() => {
      const map = {
        '--icon-h3-left': 'default:arrow-left',
        '--icon-h3-right': 'default:arrow-right',
        '--icon-quote-left': 'quot:quote-left',
        '--icon-quote-right': 'quot:quote-right'
      };
      let vars = [];
      for (const [name, key] of Object.entries(map)) {
        var raw = stellar_data('icons') && stellar_data('icons')[key];
        if (raw) vars.push(`  ${name}: url("data:image/svg+xml,${encodeURIComponent(raw)}");`);
      }
      // 加载占位：由 icons.yml 的 default:loading 提供（内联 SVG 编码为 data URI，URL 直用）
      var loadingRaw = stellar_data('icons') && stellar_data('icons')['default:loading'];
      if (loadingRaw) {
        if (loadingRaw.trim().startsWith('<svg')) {
          vars.push(`  --icon-loading: url("data:image/svg+xml,${encodeURIComponent(loadingRaw)}");`);
        } else {
          vars.push(`  --icon-loading: url("${loadingRaw}");`);
        }
      }
      return vars.length > 0 ? `:root {\n${vars.join('\n')}\n}` : '';
    })();
  %>
  <% if (iconCssVars) { %>
  <style><%- iconCssVars %></style>
  <% } %>
</head>
