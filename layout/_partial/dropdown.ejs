<%
const dropdownItem = typeof item !== 'undefined' && item ? item : {}
const items = Array.isArray(dropdownItem.items) ? dropdownItem.items.filter(child => {
  if (!child || !child.title) return false
  if (child.type === 'link') return !!child.url
  if (child.type === 'button') return !!child.onclick
  return false
}) : []
const classes = ['dropdown']
const dropdownRootClass = typeof rootClass === 'string' ? rootClass : ''
if (dropdownRootClass) {
  classes.push(dropdownRootClass)
}
const dropdownTriggerClass = typeof triggerClass === 'string' ? triggerClass : ''
const triggerClasses = ui_classes('dropdown-trigger', 'interactive', dropdownTriggerClass)
const dropdownDirection = typeof direction === 'string' ? direction : ''
const dropdownShowTitle = typeof showTitle === 'undefined' || showTitle !== false

function linkAttrs(child) {
  const url = String(child.url)
  var attrs = ' href="' + escape_html(url_for(url)) + '"'
  if (url.includes('://')) {
    attrs += ' target="_blank" rel="external nofollow noopener noreferrer"'
  } else {
    attrs += ' rel="noopener noreferrer"'
  }
  return attrs
}

function itemContent(child) {
  var body = ''
  if (child.icon) {
    body += '<span class="ui-icon">' + icon(child.icon, 'no-lazy', true) + '</span>'
  }
  body += '<span class="ui-collection__content"><span class="ui-collection__title">' + escape_html(child.title) + '</span></span>'
  return body
}

function layoutDiv() {
  if (!dropdownItem.icon || items.length === 0) {
    return ''
  }
  const title = dropdownItem.title ? escape_html(dropdownItem.title) : ''
  var el = '<details class="' + classes.join(' ') + '"'
  if (dropdownDirection) {
    el += ' direction="' + escape_html(dropdownDirection) + '"'
  }
  el += '>'
  el += '<summary class="' + triggerClasses + '"'
  if (title) {
    el += ' title="' + title + '" aria-label="' + title + '"'
  }
  el += '>'
  // dropdown 首次展开时需要立即显示图标，使用内联 SVG 避免 /js/icons.js 异步替换造成闪烁。
  el += '<span class="ui-icon">' + icon(dropdownItem.icon, 'no-lazy', true) + '</span>'
  if (dropdownShowTitle && dropdownItem.title) {
    el += '<span>' + title + '</span>'
  }
  el += '</summary>'
  el += '<div class="dropdown-menu ui-collection" data-layout="list" data-variant="nav" data-density="compact">'
  for (let child of items) {
    if (child.type === 'button') {
      el += '<button type="button" class="' + ui_classes('dropdown-item', 'collectionItem') + '" onclick="' + escape_html(child.onclick) + '">'
      el += itemContent(child) + '</button>'
    } else {
      el += '<a class="' + ui_classes('dropdown-item', 'collectionItem') + '"' + linkAttrs(child) + '>'
      el += itemContent(child) + '</a>'
    }
  }
  el += '</div></details>'
  return el
}
%>
<%- layoutDiv() %>
