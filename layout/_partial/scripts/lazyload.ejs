<script>
  // 先声明配置与初始化监听，再异步加载库：
  // 保证库执行时 lazyLoadOptions 已就绪，避免 async 脚本抢先执行导致自初始化失败
  // https://www.npmjs.com/package/vanilla-lazyload
  // Set the options globally
  // to make LazyLoad self-initialize
  window.lazyLoadOptions = {
    elements_selector: ".lazy",
    callback_loaded: (el) => {
      el.classList.add('loaded');
      // {% image %} 没有 .lazy-box 包裹，回退到父元素查找加载图标
      const wrapper = el.closest('.lazy-box') || el.parentElement;
      const icon = wrapper?.querySelector('.lazy-icon');
      if (icon) icon.remove();
    }
  };
  // 监听初始化事件，获取 LazyLoad 实例
  window.addEventListener(
    "LazyLoad::Initialized",
    function (event) {
      window.lazyLoadInstance = event.detail.instance;
    },
    false
  );
  document.addEventListener('DOMContentLoaded', function () {
    window.lazyLoadInstance?.update();
  });

  // 兜底：动态插入的 .lazy 元素（如站点自定义脚本在 update() 之后追加的图片）
  // 不会被 vanilla-lazyload 自动扫描，未注册的 img.lazy 会被 CSS opacity:0 永久隐藏。
  // MutationObserver 检测到新增 .lazy 元素后自动调用 update() 重新注册。
  if (window.MutationObserver) {
    window.lazyMutationObserver = new MutationObserver((mutations) => {
      if (window.lazyMutationObserver._pending) return;
      const hasLazy = mutations.some((m) =>
        Array.prototype.some.call(m.addedNodes, (node) =>
          node.nodeType === 1 &&
          (node.matches?.('.lazy') || !!node.querySelector?.('.lazy'))
        )
      );
      if (!hasLazy) return;
      window.lazyMutationObserver._pending = requestAnimationFrame(() => {
        window.lazyMutationObserver._pending = null;
        window.lazyLoadInstance?.update();
      });
    });
    window.lazyMutationObserver.observe(document.documentElement, {
      childList: true,
      subtree: true
    });
  }

  window.wrapLazyloadImages = (container) => {
    if (typeof container === 'string') {
      container = document.querySelector(container);
    }
    if (!container) return;

    const images = container.querySelectorAll('img');
    images.forEach((img) => {
      if (img.classList.contains('lazy')) return;

      const src = img.getAttribute('src');
      if (!src) return;

      const wrapper = document.createElement('div');
      wrapper.className = 'lazy-box';

      const newImg = img.cloneNode();
      newImg.removeAttribute('src');
      newImg.setAttribute('data-src', src);
      newImg.classList.add('lazy');

      const icon = document.createElement('div');
      icon.className = 'lazy-icon';

      wrapper.appendChild(newImg);
      wrapper.appendChild(icon);

      img.replaceWith(wrapper);
    });

    // 通知 LazyLoad 更新
    if (window.lazyLoadInstance?.update) {
      window.lazyLoadInstance.update();
    }
  }
</script>
<script async src="<%- url_for(theme.dependencies.lazyload.js) %>"></script>
