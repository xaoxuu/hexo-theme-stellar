<%
  var canonical = stellar_config('canonical')
  var encoded = Buffer.from(canonical.host || '').toString('base64');
  var canonicalWithEncoded = Object.assign({}, canonical, {
    encoded: encoded
  });
  var permalink = page.permalink || canonical.host;
  var extensions = {
    search: stellar_config('search'),
    comments: stellar_config('comments'),
    tags: stellar_config('tags'),
    features: stellar_config('features'),
    services: stellar_config('services')
  }
  var assets = extension_assets()
  var checklink = assets.services.video.js
  var clientServices = JSON.parse(JSON.stringify(assets.services))
  var siteInfoService = service_provider(extensions.services.siteInfo)
  clientServices.siteinfo.api = siteInfoService ? siteInfoService.endpoint : null
  var localSearch = extensions.search.local
  var searchProvider = extensions.search.provider === 'local' ? 'local_search' : extensions.search.provider
%>

<script data-stellar-script="defines" type="text/javascript">
  window.canonical = <%- script_json(canonicalWithEncoded) %>;
  window.canonical["param"] = <%- script_json({permalink, checklink}) %>;
  const ctx = {
    date_suffix: {
      just: <%- script_json(__('meta.date_suffix.just')) %>,
      min: <%- script_json(__('meta.date_suffix.min')) %>,
      hour: <%- script_json(__('meta.date_suffix.hour')) %>,
      day: <%- script_json(__('meta.date_suffix.day')) %>,
    },
    root : <%- script_json(config.root) %>,
    tag_plugins: {
      chat: {api: <%- script_json(assets.services.chat.endpoint) %>},
    },
    // 图标由构建期生成的 /js/stellar-icons.js 填充（defer，早于 DOMContentLoaded 就绪）
    icons: {},
    ui: { classes: <%- script_json(ui_capabilities()) %> },
    services: <%- script_json(clientServices) %>,
  };

  // required plugins (only load if needs)
  if (<%- script_json(searchProvider || '') %>) {
    ctx.search = { more: <%- script_json(__('btn.more')) %> };
    ctx.search.service = <%- script_json(searchProvider || '') %>;
    if (ctx.search.service == 'local_search') {
      let service_obj = <%- script_json({
        field: localSearch.scope,
        path: '/search.json',
        content: localSearch.includeContent,
        lazy_load: true,
        cache_ttl: localSearch.cacheTtlSeconds
      }) %>;
      ctx.search[ctx.search.service] = service_obj;
      ctx.search.path = service_obj.path;
    }
  }
  const def = {
    avatar: <%- script_json(stellar_config('fallbacks.avatar')) %>,
    cover: <%- script_json(stellar_config('fallbacks.cover')) %>,
  };
  // 经典脚本仍消费这些只读投影。
  window.ctx = ctx;
  window.def = def;

</script>
