<%
var renderViewModel = typeof viewModel !== 'undefined' ? viewModel : null

function custom_inject() {
  return stellar_inject('bodyEnd', renderViewModel ? renderViewModel.render.document.bodyEndInject : content_config(page).inject?.bodyEnd)
}

// tagtree 脚本仅在最终 Region 实例包含 tagtree 时加载。
function tagtreeWidgetOnPage() {
  var regions = renderViewModel?.render.layout.regions
    || page.notebookIndex?.collection?.layout.regions
    || {};
  var widgets = Object.values(regions).flatMap(function (region) {
    return Array.isArray(region?.widgets) ? region.widgets : []
  })
  if (!Array.isArray(widgets)) {
    return false;
  }
  return widgets.some(function (w) {
    if (w && typeof w === 'object') {
      return w.id === 'tagtree' || w.layout === 'tagtree' || w.override === 'tagtree';
    }
    return false;
  });
}

%>
<%- partial('scripts/defines') %>

<!-- core: 迁移期 DOM/资源兼容工具；Extension 注册与生命周期由 ESM runtime 所有 -->
<script src="<%- url_for('/js/utils.js') %>?v=<%- stellar_info('version') %>"></script>
<script defer src="<%- url_for('/js/stellar-icons.js') %>?v=<%- stellar_info('version') %>"></script>
<script src="<%- url_for(`${stellar_info('main_js')}?v=${stellar_info('version')}`) %>" defer></script>
<script defer src="<%- url_for('/js/profile.js') %>?v=<%- stellar_info('version') %>"></script>

<% if (tagtreeWidgetOnPage()) { %>
  <script>window.__STELLAR_TAGTREE__ = { expand_active: <%- JSON.stringify(!!(stellar_data('widgets').tagtree && stellar_data('widgets').tagtree.expand_active)) %> };</script>
  <script defer src="<%- url_for('/js/tagtree.js') %>?v=<%- stellar_info('version') %>"></script>
<% } %>

<%- partial('scripts/runtime', {viewModel: typeof viewModel !== 'undefined' ? viewModel : null}) %>

<!-- inject -->
<%- custom_inject() %>
