<%
function layoutDiv() {
  var currentMenu = typeof activeMenu !== 'undefined' ? activeMenu : page.navigation?.menu
  var entries = []
  for (var menuItem of (theme.menubar.items || [])) {
    if (menuItem == null || menuItem.id == null || menuItem.url == null || menuItem.title == null) {
      continue
    }
    entries.push({
      href: pretty_url(menuItem.url),
      title: __(menuItem.title),
      icon: menuItem.icon,
      theme: menuItem.theme,
      active: menuItem.id == currentMenu,
      className: menuItem.theme?.length > 0 ? 'is-themed' : '',
      gradientId: 'menu-grad-' + menuItem.id
    })
  }
  return partial('_partial/primitives/navigation', {
    placement: where == 'main' ? 'main' : 'sidebar',
    entries: entries
  })
}
%>

<%- layoutDiv() %>
