<%
var brand = (typeof brandModel !== 'undefined' ? brandModel : null) || {}
var brandPlacement = typeof placement !== 'undefined' ? placement : 'leftbar'
var activeViewModel = typeof viewModel !== 'undefined' ? viewModel : null
var brandStyle = brandPlacement === 'topbar'
  ? 'topbar'
  : brand.style === 'compact' ? 'compact' : 'regular'

function layoutBrandNavigation() {
  if (brandPlacement !== 'leftbar' || brand.source !== 'collection' || brand.backButton !== true) return ''
  const href = brand.backHref
  if (!href) return ''
  return `<div class="brand-navigation"><a class="brand-navigation__back cap" href="${pretty_url(href)}"><span class="ui-icon">${icon('default:back', '', true)}</span><span>${__(brand.backLabel)}</span></a></div>`
}

function layoutBrandSearch() {
  if (brandPlacement !== 'leftbar' || brand.source !== 'collection' || brand.search !== true) return ''
  if (!stellar_config('search.provider')) return ''
  var body = partial('_partial/sidebar/search', {
    item: {algoliaFilterPath: 'auto'},
    instanceId: 'collection-brand-search',
    presentation: 'leftbar',
    hoverSurface: true,
    viewModel: activeViewModel
  })
  return body.trim().length > 0 ? `<div class="brand-search">${body}</div>` : ''
}

function layoutBrandTitle() {
  const name = brandText(brand.name)
  if (!name) return ''
  const tagline = brandText(brand.tagline)
  const href = brandText(brand.href)
  const tag = href ? 'a' : 'div'
  var el = `<${tag} class="brand-title"${href ? ` href="${escape_html(url_for(href))}"` : ''}>`
  el += `<div class="brand-name">${escape_html(name)}</div>`
  if (brandStyle !== 'topbar' && tagline) {
    el += `<div class="brand-tagline cap">${escape_html(tagline)}</div>`
  }
  el += `</${tag}>`
  return el
}

function layoutBrandImage() {
  var image = brand.image
  var src = brandText(image?.src)
  if (!src) return ''
  var href = brandText(brand.href)
  var tag = href ? 'a' : 'div'
  var variant = image?.variant || 'icon'
  var el = `<${tag} class="brand-image brand-image--${variant}"${href ? ` href="${escape_html(url_for(href))}"` : ''}>`
  if (src) {
    el += `<img no-lazy src="${escape_html(src)}" alt="">`
  } else {
    el += icon('default:documents', '', true)
  }
  el += `</${tag}>`
  return el
}

function layoutBrandGithub() {
  if (brandPlacement !== 'leftbar' || brandStyle !== 'regular') return ''
  const username = typeof brandGithubUsername === 'function' ? brandGithubUsername() : ''
  const apiBase = brandText(stellar_config('services.github.apiUrl')).replace(/\/+$/, '')
  if (!username || !apiBase) return ''
  const encodedUsername = encodeURIComponent(username)
  const githubHref = `https://github.com/${encodedUsername}`
  const items = [
    {key: 'followers', label: 'followers', href: githubHref + '?tab=followers'},
    {key: 'following', label: 'following', href: githubHref + '?tab=following'},
    {key: 'public_repos', label: 'repos', href: githubHref + '?tab=repositories'}
  ]
  var el = `<div class="brand-stats data-service ds-ghinfo" data-api="${escape_html(apiBase + '/users/' + encodedUsername)}">`
  items.forEach(item => {
    el += `<a class="${ui_classes('brand-stat')}" href="${escape_html(item.href)}">`
    el += `<span class="brand-stat__value" type="text" id="${item.key}"></span>`
    el += `<span class="brand-stat__label">${item.label}</span></a>`
  })
  el += `</div>`
  return el
}

function layoutBrand() {
  if (!brand.image?.src && !brand.name) return ''
  var el = `<header class="brand-header brand-header--${brandStyle}${brandPlacement === 'main' ? ' mobile-only' : ''}">`
  el += layoutBrandNavigation()
  el += `<div class="brand-wrap">`
  el += layoutBrandImage()
  el += layoutBrandTitle()
  el += layoutBrandGithub()
  el += `</div>`
  el += layoutBrandSearch()
  el += `</header>`
  return el
}
%>
<%- layoutBrand() %>
