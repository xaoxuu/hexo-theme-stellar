<%
var brand = typeof brandModel !== 'undefined' ? brandModel : brandConfig(page)

function layoutBrandTitle() {
  const name = brandText(brand.name)
  const wordmark = brandText(brand.wordmark)
  if (!name && !wordmark) return ''
  const tagline = brandText(brand.tagline?.text)
  const taglineHover = brandText(brand.tagline?.hover)
  const href = brandText(brand.href)
  const tag = href ? 'a' : 'div'
  var el = `<${tag} class="brand-title"${href ? ` href="${escape_html(url_for(href))}"` : ''}>`
  if (wordmark) {
    el += `<img class="brand-wordmark" no-lazy src="${escape_html(wordmark)}" alt="${escape_html(name)}">`
  } else {
    el += `<div class="brand-name">${escape_html(name)}</div>`
  }
  if (tagline) {
    el += `<div class="brand-tagline${taglineHover ? ' normal' : ''} cap">${escape_html(tagline)}</div>`
    if (taglineHover) {
      el += `<div class="brand-tagline hover cap" style="opacity:0">${escape_html(taglineHover)}</div>`
    }
  }
  el += `</${tag}>`
  return el
}

function layoutBrandImage() {
  const image = brand.image
  if (!image?.src) return ''
  const src = brandText(image.src)
  const href = brandText(image.href)
  const tag = href ? 'a' : 'div'
  var variant = image.variant
  var el = `<${tag} class="brand-image brand-image--${variant}"${href ? ` href="${escape_html(url_for(href))}"` : ''}>`
  if (variant === 'avatar' && stellar_config('appearance.motion.avatar') !== 'never') {
    el += `<div class="brand-image-bg"></div>`
  }
  el += `<img no-lazy src="${escape_html(src)}" alt="">`
  el += `</${tag}>`
  return el
}

function layoutWikiHome() {
  var wikiViewModel = typeof viewModel !== 'undefined' && viewModel?.collection?.profile === 'wiki'
    ? viewModel
    : null
  if (wikiViewModel) {
    if (placement !== 'sidebar' || wikiViewModel.render.layout.showWikiHome === false) return ''
    var el = `<div class="wiki-home-wrap">`
    el += `<a class="wiki-home cap" href="${pretty_url(wikiViewModel.render.layout.wikiIndexPath)}">`
    el += icon('default:arrow-left', '', true)
    el += `<span>${__('btn.all_wiki')}</span>`
    el += `</a></div>`
    return el
  }
  if (placement !== 'sidebar' || !collection_id(page, 'wiki')) return ''
  var wiki = stellar_data('wiki').tree[collection_id(page, 'wiki')]
  const enabled = content_config(page).sidebar?.left?.wikiHome ?? wiki?.sidebar?.left?.wikiHome ?? true
  if (enabled === false) return ''
  var el = `<div class="wiki-home-wrap">`
  el += `<a class="wiki-home cap" href="${pretty_url(stellar_config('layout.profiles.wikiIndex.path'))}">`
  el += icon('default:arrow-left', '', true)
  el += `<span>${__('btn.all_wiki')}</span>`
  el += `</a></div>`
  return el
}

function layoutBrand() {
  if (!brand.image?.src && !brand.name && !brand.wordmark) return ''
  var el = `<header class="brand-header${placement === 'main' ? ' mobile-only' : ''}">`
  el += `<div class="brand-wrap">`
  el += layoutBrandImage()
  el += layoutBrandTitle()
  el += `</div></header>`
  return el
}
%>
<%- layoutWikiHome() %>
<%- layoutBrand() %>
