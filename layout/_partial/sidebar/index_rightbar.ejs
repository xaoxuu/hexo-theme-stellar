<%

const wiki = theme.wiki.tree[collection_id(page, "wiki")]
const topic = theme.topic.tree[collection_id(page, "topic")]
const notebook = theme.notebooks.tree[collection_id(page, "notebook")]
const postViewModel = typeof viewModel !== 'undefined' && viewModel?.collection?.profile === 'post'
  ? viewModel
  : null

var sidebarState
if (postViewModel) {
  sidebarState = postViewModel.item.presentation.sidebar?.right || {}
} else {
  page.sidebar ||= {}
  page.sidebar.right ||= {}
  if (page.sidebar.right.widgets == null) {
  const { site_tree } = theme
  var sidebar
  if (is_home()) {
    sidebar = site_tree.home.sidebar.right.widgets
  } else if (page.layout === 'notebooks') {
    // 笔记本列表页
    sidebar = site_tree.notebooks.sidebar.right.widgets
  } else if (page.layout === 'notes') {
    // 笔记列表页
    sidebar = notebook ? notebook.sidebar?.right?.widgets : site_tree.notes.sidebar.right.widgets
  } else if (notebook) {
    // 笔记本文章内页
    sidebar = notebook.note?.sidebar?.right?.widgets
  } else if (is_category() || is_tag() || is_archive() || ['categories', 'tags', 'archives'].includes(page.layout)) {
    sidebar = site_tree.index_blog.sidebar.right.widgets
  } else if (page.layout === 'index_topic') {
    // 专栏列表页等同于博客列表页
    sidebar = site_tree.index_blog.sidebar.right.widgets
  } else if (collection_id(page, "topic")?.length > 0) {
    // 专栏文章内页等同于普通文章内页
    sidebar = site_tree.post.sidebar.right.widgets
  } else if (page.layout === 'index_wiki') {
    sidebar = site_tree.index_wiki.sidebar.right.widgets
  } else if (collection_id(page, "wiki")?.length > 0) {
    sidebar = site_tree.wiki.sidebar.right.widgets
  } else if (page.layout === '404') {
    sidebar = site_tree.error_page.sidebar.right.widgets
  } else if (page.layout === 'page') {
    sidebar = site_tree.page.sidebar.right.widgets
  } else if (page.layout === 'post') {
    sidebar = site_tree.post.sidebar.right.widgets
  } else if (page.layout == null) {
    sidebar = site_tree.page.sidebar.right.widgets
  } else {
    sidebar = []
  }

  if (topic?.sidebar?.right?.widgets) {
    sidebar = topic.sidebar.right.widgets
  }
  if (wiki?.sidebar?.right?.widgets) {
    sidebar = wiki.sidebar.right.widgets
  }

    page.sidebar.right.widgets = sidebar
  }
  sidebarState = page.sidebar.right
}

function layoutWidgets() {
  if (sidebarState.widgets == null || sidebarState.widgets.length == 0) {
    return ''
  }
  var el = ''
  if (sidebarState.widgets) {
    sidebarState.widgets.forEach((w, i) => {
      let name = ''
      let widget = {}
      if (typeof w == 'string') {
        name = w
      } else if (typeof w == 'object' && w.override) {
        name = w.override
      }
      if (name in theme.widgets) {
        Object.assign(widget, theme.widgets[name])
      }
      if (typeof w == 'object' && (w.override || w.layout)) {
        Object.assign(widget, w)
      }
      if (widget && widget.layout) {
        el += partial('../widgets/' + widget.layout, {item: widget})
      }
    });
  }
  if (el.trim().length > 0) {
    return `<div class="widgets">${el}</div>`
  } else {
    return ''
  }
}

%>
<%- layoutWidgets() %>
