<%
var wikiViewModel = typeof viewModel !== 'undefined' && viewModel?.collection?.profile === 'wiki'
  ? viewModel
  : null
var notebookViewModel = typeof viewModel !== 'undefined' && viewModel?.collection?.profile === 'notebook'
  ? viewModel
  : null
var notebookIndex = page.notebookIndex?.mode === 'notes' ? page.notebookIndex.collection : null
item = item && typeof item === 'object' ? Object.assign({}, item) : {}
if (item.algoliaFilterPath == null) {
  item.algoliaFilterPath = 'auto'
}
if (item.placeholder == null && item.algoliaFilterPath == 'auto') {
  if (wikiViewModel) {
    item.placeholder = __('search.search_in', wikiViewModel.collection.identity.name)
  } else if (stellar_data('wiki').tree[collection_id(page, "wiki")]?.name) {
    item.placeholder = __('search.search_in', stellar_data('wiki').tree[collection_id(page, "wiki")]?.name)
  } else if (notebookViewModel) {
    item.placeholder = __('search.search_in', notebookViewModel.collection.identity.name || __('btn.notebook'))
    item.algoliaFilterPath = notebookViewModel.render.layout.algoliaFilterPath
  } else if (notebookIndex) {
    item.placeholder = __('search.search_in', notebookIndex.name || __('btn.notebook'))
    item.algoliaFilterPath = notebookIndex.layout.algoliaFilterPath
  }
}
function layoutDiv() {
  if (typeof disabled !== 'undefined' && disabled === true) {
    return ''
  }
  var rawInstanceId = typeof instanceId === 'string' && instanceId.length > 0 ? instanceId : 'default'
  var algoliaFilterPath = ''
  if (item.algoliaFilterPath == 'auto') {
    if (wikiViewModel) {
      algoliaFilterPath = wikiViewModel.render.layout.algoliaFilterPath
    } else if (notebookViewModel) {
      algoliaFilterPath = notebookViewModel.render.layout.algoliaFilterPath
    } else if (notebookIndex) {
      algoliaFilterPath = notebookIndex.layout.algoliaFilterPath
    } else if (collection_id(page, "wiki")) {
      let matches = page.path.match(/(.*?)\/(.*?)\//i)
      if (matches?.length > 0) {
        algoliaFilterPath = matches[0]
      }
    }
  } else {
    if (item.algoliaFilterPath?.length > 0) {
      algoliaFilterPath = item.algoliaFilterPath
    }
  }
  if (algoliaFilterPath.length > 0 && !algoliaFilterPath.startsWith('/')) {
    algoliaFilterPath = '/' + algoliaFilterPath
  }
  var placeholder = item.placeholder || (algoliaFilterPath.length > 0 ? __('search.search_in', algoliaFilterPath) : __('search.search'))
  var searchScope = search_scope(page, typeof viewModel !== 'undefined' ? viewModel : null)
  if (searchScope) placeholder = searchScope.currentPlaceholder
  var searchPresentation = typeof presentation === 'string' ? presentation : 'leftbar'
  var iconOnly = searchPresentation === 'topbar' || searchPresentation === 'wiki-toolbar'
  var searchClassName = typeof hoverSurface !== 'undefined' && hoverSurface === true
    ? 'search-trigger has-hover-surface'
    : 'search-trigger'
  var searchAttrs = {
    title: placeholder,
    'aria-label': placeholder,
    'data-shell-action': 'open-search',
    'data-search-instance': rawInstanceId,
    'data-search-placeholder': placeholder
  }
  if (stellar_config('search.provider') === 'algolia' && algoliaFilterPath.length > 0) {
    searchAttrs['data-algolia-filter-path'] = algoliaFilterPath
  }
  if (searchScope) {
    searchAttrs['data-search-domain'] = searchScope.current
    searchAttrs['data-search-domain-label'] = searchScope.currentLabel
    searchAttrs['data-search-domain-blog'] = searchScope.hasBlog ? 'true' : 'false'
  }
  return partial('_partial/components/collection', {options: {
    layout: 'list',
    variant: 'nav',
    items: [{
      type: 'button',
      title: placeholder,
      icon: 'default:search',
      iconOnly: iconOnly,
      className: searchClassName,
      attrs: searchAttrs
    }]
  }})
}
%>
<%- layoutDiv() %>
