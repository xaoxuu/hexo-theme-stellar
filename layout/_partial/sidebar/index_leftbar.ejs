<%

var wikiViewModel = typeof viewModel !== 'undefined' && viewModel?.collection?.profile === 'wiki'
  ? viewModel
  : null
var wiki = wikiViewModel ? null : stellar_data('wiki').tree[collection_id(page, "wiki")]
var topic = typeof viewModel !== 'undefined' && viewModel?.collection?.profile === 'topic'
  ? null
  : stellar_data('topic').tree[collection_id(page, "topic")]
var notebookViewModel = typeof viewModel !== 'undefined' && viewModel?.collection?.profile === 'notebook'
  ? viewModel
  : null
var notebookIndex = page.notebookIndex?.mode === 'notes' ? page.notebookIndex.collection : null
var postViewModel = typeof viewModel !== 'undefined' && ['post', 'topic'].includes(viewModel?.collection?.profile)
  ? viewModel
  : null

var sidebarState
if (postViewModel || wikiViewModel || notebookViewModel) {
  var activeViewModel = postViewModel || wikiViewModel || notebookViewModel
  sidebarState = wikiViewModel
    ? wikiViewModel.render.layout.sidebar?.left || {}
    : notebookViewModel
      ? notebookViewModel.render.layout.sidebar?.left || {}
    : postViewModel.collection.profile === 'topic'
      ? postViewModel.render.layout.sidebar?.left || {}
      : postViewModel.item.presentation.sidebar?.left || {}
} else {
  sidebarState = Object.assign({}, content_config(page).sidebar?.left || {})
  if (sidebarState.widgets == null) {
    var profiles = stellar_config('layout.profiles')
    var sidebar
    if (is_home()) {
      sidebar = profiles.home.sidebar.left
    } else if (page.layout === 'notebooks') {
      // 笔记本列表页
      sidebar = profiles.notebookIndex.sidebar.left
    } else if (page.layout === 'notes') {
      // 笔记列表页
      sidebar = notebookIndex?.layout.sidebar?.left?.widgets || profiles.noteIndex.sidebar.left
    } else if (is_category() || is_tag() || is_archive() || ['categories', 'tags', 'archives'].includes(page.layout)) {
      sidebar = profiles.blogIndex.sidebar.left
    } else if (page.layout === 'index_topic') {
      sidebar = profiles.topicIndex.sidebar.left
    } else if (collection_id(page, "topic")?.length > 0) {
      sidebar = profiles.topic.sidebar.left
    } else if (page.layout === 'index_wiki') {
      sidebar = profiles.wikiIndex.sidebar.left
    } else if (collection_id(page, "wiki")?.length > 0) {
      sidebar = profiles.wiki.sidebar.left
    } else if (page.layout === '404') {
      sidebar = profiles.error.sidebar.left
    } else if (page.layout === 'page') {
      sidebar = profiles.page.sidebar.left
    } else if (page.layout === 'post') {
      sidebar = profiles.post.sidebar.left
    } else if (page.layout == null) {
      sidebar = profiles.page.sidebar.left
    } else {
      sidebar = []
    }

    if (topic?.sidebar?.left?.widgets) {
      sidebar = topic.sidebar.left.widgets
    }
    if (wiki?.sidebar?.left?.widgets) {
      sidebar = wiki.sidebar.left.widgets
    }

    sidebarState.widgets = sidebar
  }
}


function layoutWidgets() {
  var el = '';
  el += '<div class="widgets">';
  // 左栏共用的 SVG 渐变定义（供激活书签等彩色图标使用，见 grad-def.ejs）
  el += partial('grad-def', {id: 'leftbar-active-icon-grad'})
  // 导航区放进组件滚动区，一起滚动
  el += layoutNavArea()
  if (sidebarState.widgets) {
    sidebarState.widgets.forEach((w, i) => {
      let name = ''
      let widget = {}
      if (typeof w == 'string') {
        name = w
      } else if (typeof w == 'object' && w.override) {
        name = w.override
      }
      if (name in stellar_data('widgets')) {
        Object.assign(widget, stellar_data('widgets')[name])
      }
      if (typeof w == 'object' && (w.override || w.layout)) {
        Object.assign(widget, w)
      }
      if (widget && widget.layout) {
        el += partial('../widgets/' + widget.layout, {item: widget, viewModel: activeViewModel})
      }
    });
  }
  el += '</div>';
  return el;
}
function layoutSearch() {
  if (!sidebarState.widgets) {
    return ''
  }
  var search = {}
  if (sidebarState.search) {
    search = sidebarState.search
  } else if (wiki?.sidebar?.left?.search) {
    search = wiki.sidebar.left.search
  } else if (topic?.sidebar?.left?.search) {
    search = topic.sidebar.left.search
  }
  return partial('search', {item: search, disabled: sidebarState.search === false, viewModel: activeViewModel})
}
function layoutFooterDiv() {
  var actions = stellar_config('site.footer.actions')
  if (!Array.isArray(actions) || actions.length === 0) {
    return ''
  }
  var el = '<footer class="footer dis-select">';
  el += '<div class="social-wrap" style="--item-grad:url(#footer-social-icon-grad)">';
  el += partial('grad-def', {id: 'footer-social-icon-grad'})
  for (var item of actions) {
    if (item.type === 'spacer') {
      el += '<span class="social-spacer" aria-hidden="true"></span>';
    } else if (item.type === 'dropdown') {
      el += partial('../dropdown', {
        item: item,
        rootClass: 'social-dropdown',
        triggerClass: 'social',
        showTitle: false
      })
    } else if (item.type === 'link') {
      el += '<a class="social"';
      if (item.title) {
        el += ' title="' + escape_html(item.title) + '"';
      }
      if (item.url) {
        el += ' href="' + escape_html(url_for(item.url)) + '"';
        if (item.url.includes('://')) {
          el += ' target="_blank" rel="external nofollow noopener noreferrer"';
        } else {
          el += ' rel="noopener noreferrer"';
        }
      }
      el += '>';
      el += icon(item.icon, 'no-lazy')
      el += '</a>';
    }
  }
  el += '</div>';
  el += '</footer>';
  return el;
}

function layoutBrand() {
  return partial('brand', {
    placement: 'sidebar',
    brandModel: activeViewModel ? activeViewModel.render.layout.brand : notebookIndex?.layout.brand,
    viewModel: activeViewModel
  })
}

function layoutNavArea() {
  var el = ''
  if (sidebarState.menu === false) {
    return el
  }
  // Wiki 内容页默认隐藏导航区，可在页面或项目左侧栏配置中开启。
  if (wikiViewModel) {
    if (sidebarState.menu !== true) return el
  } else if (collection_id(page, "wiki")?.length > 0) {
    if (sidebarState.menu !== true && wiki?.sidebar?.left?.menu !== true) {
      return el
    }
  }
  el += `<div class="nav-area">`
  el += partial('menu', {
    where: 'sidebar',
    activeMenu: activeViewModel ? activeViewModel.item.navigation.menu : notebookIndex?.navigation.menu
  })
  el += `</div>`
  return el
}
%>
<%- layoutBrand() %>
<%- layoutSearch() %>
<%- layoutWidgets() %>
<%- layoutFooterDiv() %>
