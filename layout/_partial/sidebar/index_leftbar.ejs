<%

const wiki = theme.wiki.tree[collection_id(page, "wiki")]
const topic = theme.topic.tree[collection_id(page, "topic")]
const notebook = theme.notebooks.tree[collection_id(page, "notebook")]
const postViewModel = typeof viewModel !== 'undefined' && viewModel?.collection?.profile === 'post'
  ? viewModel
  : null

var sidebarState
if (postViewModel) {
  sidebarState = postViewModel.item.presentation.sidebar?.left || {}
} else {
  page.sidebar ||= {}
  page.sidebar.left ||= {}
  if (page.sidebar.left.widgets == null) {
  const { site_tree } = theme
  var sidebar
  if (is_home()) {
    sidebar = site_tree.home.sidebar.left.widgets
  } else if (page.layout === 'notebooks') {
    // 笔记本列表页
    sidebar = site_tree.notebooks.sidebar.left.widgets
  } else if (page.layout === 'notes') {
    // 笔记列表页
    sidebar = notebook ? notebook.sidebar?.left?.widgets : site_tree.notes.sidebar.left.widgets
  } else if (notebook) {
    // 笔记本文章内页
    sidebar = notebook.note?.sidebar?.left?.widgets
  } else if (is_category() || is_tag() || is_archive() || ['categories', 'tags', 'archives'].includes(page.layout)) {
    sidebar = site_tree.index_blog.sidebar.left.widgets
  } else if (page.layout === 'index_topic') {
    // 专栏列表页等同于博客列表页
    sidebar = site_tree.index_blog.sidebar.left.widgets
  } else if (collection_id(page, "topic")?.length > 0) {
    // 专栏文章内页等同于普通文章内页
    sidebar = site_tree.post.sidebar.left.widgets
  } else if (page.layout === 'index_wiki') {
    sidebar = site_tree.index_wiki.sidebar.left.widgets
  } else if (collection_id(page, "wiki")?.length > 0) {
    sidebar = site_tree.wiki.sidebar.left.widgets
  } else if (page.layout === '404') {
    sidebar = site_tree.error_page.sidebar.left.widgets
  } else if (page.layout === 'page') {
    sidebar = site_tree.page.sidebar.left.widgets
  } else if (page.layout === 'post') {
    sidebar = site_tree.post.sidebar.left.widgets
  } else if (page.layout == null) {
    sidebar = site_tree.page.sidebar.left.widgets
  } else {
    sidebar = []
  }

  if (topic?.sidebar?.left?.widgets) {
    sidebar = topic.sidebar.left.widgets
  }
  if (wiki?.sidebar?.left?.widgets) {
    sidebar = wiki.sidebar.left.widgets
  }

    page.sidebar.left.widgets = sidebar
  }
  sidebarState = page.sidebar.left
}


function layoutWidgets() {
  var el = '';
  el += '<div class="widgets">';
  // 左栏共用的 SVG 渐变定义（供激活书签等彩色图标使用，见 grad-def.ejs）
  el += partial('grad-def', {id: 'leftbar-active-icon-grad'})
  // 导航区放进组件滚动区，一起滚动
  el += layoutNavArea()
  if (sidebarState.widgets) {
    sidebarState.widgets.forEach((w, i) => {
      let name = ''
      let widget = {}
      if (typeof w == 'string') {
        name = w
      } else if (typeof w == 'object' && w.override) {
        name = w.override
      }
      if (name in theme.widgets) {
        Object.assign(widget, theme.widgets[name])
      }
      if (typeof w == 'object' && (w.override || w.layout)) {
        Object.assign(widget, w)
      }
      if (widget && widget.layout) {
        el += partial('../widgets/' + widget.layout, {item: widget})
      }
    });
  }
  el += '</div>';
  return el;
}
function layoutSearch() {
  if (!sidebarState.widgets) {
    return ''
  }
  var search = {}
  if (sidebarState.search) {
    search = sidebarState.search
  } else if (wiki?.sidebar?.left?.search) {
    search = wiki.sidebar.left.search
  } else if (topic?.sidebar?.left?.search) {
    search = topic.sidebar.left.search
  }
  return partial('search', {item: search, disabled: sidebarState.search === false})
}
function layoutFooterDiv() {
  const { social } = theme.footer
  if (social == null) {
    return ''
  }
  var el = '<footer class="footer dis-select">';
  el += '<div class="social-wrap" style="--item-grad:url(#footer-social-icon-grad)">';
  el += partial('grad-def', {id: 'footer-social-icon-grad'})
  for (let id of Object.keys(social)) {
    let item = social[id];
    if (id === 'spacer') {
      el += '<span class="social-spacer" aria-hidden="true"></span>';
    } else if (item?.type === 'dropdown') {
      el += partial('../dropdown', {
        item: item,
        rootClass: 'social-dropdown',
        triggerClass: 'social',
        showTitle: false
      })
    } else if (item?.icon && (item.url || item.onclick)) {
      el += '<a class="social"';
      if (item.title) {
        el += ' title="' + escape_html(item.title) + '"';
      }
      if (item.url) {
        el += ' href="' + escape_html(url_for(item.url)) + '"';
        if (item.url.includes('://')) {
          el += ' target="_blank" rel="external nofollow noopener noreferrer"';
        } else {
          el += ' rel="noopener noreferrer"';
        }
      } else if (item.onclick) {
        item.onclick = item.onclick.replace(/"|\'/g, '&quot;');
        el += ' onclick="' + item.onclick + '"';
      }
      el += '>';
      el += icon(item.icon, 'no-lazy')
      el += '</a>';
    }
  }
  el += '</div>';
  el += '</footer>';
  return el;
}

function layoutBrand() {
  return partial('brand', {
    placement: 'sidebar',
    brandModel: postViewModel ? postViewModel.render.layout.brand : undefined
  })
}

function layoutNavArea() {
  var el = ''
  if (sidebarState.menu === false) {
    return el
  }
  // Wiki 内容页默认隐藏导航区，可在页面或项目左侧栏配置中开启。
  if (collection_id(page, "wiki")?.length > 0) {
    if (sidebarState.menu !== true && wiki?.sidebar?.left?.menu !== true) {
      return el
    }
  }
  el += `<div class="nav-area">`
  el += partial('menu', {
    where: 'sidebar',
    activeMenu: postViewModel ? postViewModel.item.navigation.menu : undefined
  })
  el += `</div>`
  return el
}
%>
<%- layoutBrand() %>
<%- layoutSearch() %>
<%- layoutWidgets() %>
<%- layoutFooterDiv() %>
