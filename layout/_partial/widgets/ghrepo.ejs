<%
function layoutDiv() {
  var el = '';
  var repo;
  var repoApi;
  var tagsApi;
  var pageConfig = content_config(page);
  var wikiViewModel = typeof viewModel !== 'undefined' && viewModel?.collection?.profile === 'wiki'
    ? viewModel
    : null
  if (wikiViewModel) {
    repo = wikiViewModel.render.listing.repository
    repoApi = wikiViewModel.render.listing.repositoryApi
    tagsApi = repoApi ? repoApi + '/tags' : ''
  } else if (pageConfig.source?.repository) {
    repo = pageConfig.source.repository
  } else if (stellar_data('wiki').tree[collection_id(page, "wiki")]?.source?.repository) {
    var proj = stellar_data('wiki').tree[collection_id(page, "wiki")]
    repo = proj.source?.repository
  }
  if (!repo) {
    return el;
  }
  if (!wikiViewModel) {
    repoApi = stellar_config('extensions.services.github.apiUrl') + '/repos/' + repo
    tagsApi = repoApi + '/tags'
  }
  // 布局
  el += `<widget class="widget-wrapper${scrollreveal(' ')} ghrepo">`
  // body
  el += '<div class="widget-body">';
  el += '<div class="items data-service ds-ghinfo" data-api="' + escape_html(repoApi) + '">';
  el += '<a class="repo" href="https://github.com/' + repo + '" target="_blank" rel="external nofollow noopener noreferrer">';
    el += '<div class="repo-name flex-row">';
      el += icon('github:repo')
      el += repo;
    el += '</div>';
    el += '<div class="repo-desc"><span type="text" id="description">&nbsp;</span></div>';
    el += '<div class="grid">';
      el += '<div class="flex-row">';
        el += icon('github:star')
        el += '<span type="text" id="stargazers_count"></span>';
      el += '</div>';
      el += '<div class="flex-row">';
        el += icon('github:fork')
        el += '<span type="text" id="forks_count"></span>';
      el += '</div>';
      el += '<div class="flex-row data-service ds-ghinfo" index="0" data-api="' + escape_html(tagsApi) + '">';
        el += icon('github:tag')
        el += '<span type="text" id="latest-tag-name">0</span>';
      el += '</div>';
    el += '</div>';
  el += '</a>';
  el += '</div>';
  el += '</div>';
  el += '</widget>';
  return el;
}
%>
<%- layoutDiv() %>
