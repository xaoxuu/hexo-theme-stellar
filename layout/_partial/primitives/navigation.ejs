<%
var allowedPlacements = ['main', 'leftbar', 'topbar', 'rightbar']
if (!allowedPlacements.includes(placement)) {
  throw new Error('Stellar Layout Navigation: 未知 placement ' + placement)
}
var navigationItems = Array.isArray(entries) ? entries : []
var navigationBody = partial('_partial/components/collection', {options: {
  layout: placement === 'leftbar' && typeof columns !== 'undefined' && columns > 1 ? 'grid' : 'list',
  columns: typeof columns !== 'undefined' ? columns : 1,
  variant: placement === 'leftbar' && typeof columns !== 'undefined' && columns > 2 ? 'icon' : 'nav',
  items: navigationItems
}})
var html = ''
if ((navigationBody || '').trim().length > 0) {
  html = `<nav class="menu dis-select${placement === 'main' ? ' mobile-hidden' : ''}">${navigationBody}</nav>`
}
%>
<%- html %>
