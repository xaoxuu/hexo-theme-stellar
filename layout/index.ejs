<%
page.navigation ||= {}
if (page.navigation.menu == undefined) {
  page.navigation.menu = stellar_config('layout.profiles.home.navigation.activeMenu');
}
if (page.title && collection_id(page, "wiki")) {
  page.robots = 'noindex,follow';
}
// 首页评论区：仅首页第一页，默认不显示，可通过 layout.profiles.home.comments 开启/覆盖
var homeCmt = stellar_config('layout.profiles.home.comments')
if (homeCmt && homeCmt !== false && is_home_first_page()) {
  if (typeof homeCmt === 'object') {
    page.comments = {
      enabled: homeCmt.enabled !== false,
      title: homeCmt.title,
      id: homeCmt.id,
      service: homeCmt.provider
    }
    if (homeCmt.provider) page.comments[homeCmt.provider] = homeCmt.options
  } else {
    page.comments = {enabled: true}
  }
}

// 置顶文章样式：carousel = 轮播（默认），flat = 平铺（首页列表靠前展示）
var articleDefaults = stellar_config('content.article')
var pinStyle = articleDefaults.listing.pinnedLayout
var pinFlat = pinStyle === 'flat'

// 与 pin_slider.ejs 保持一致的置顶判定与排序权重
function pinValue(post) {
  return postListing(post).priority
}
function isTopicPost(post) {
  return post?.collection?.type === 'topic'
}
function requirePostViewModel(post) {
  var viewModel = post_view_model(post)
  if (viewModel?.collection?.profile !== 'post' || !viewModel.render?.listing) {
    throw new Error(`Stellar v2: 普通 Post ${post?.source || post?.path || '<unknown>'} 缺少列表 ViewModel`)
  }
  return viewModel
}
function postListing(post) {
  if (isTopicPost(post)) {
    return {
      priority: post.listing?.priority || 0,
      listed: post.visibility?.listed !== false,
      cover: post.card?.cover,
      cardStyle: articleDefaults.listing.cardLayout,
      href: post.link || post.path
    }
  }
  return requirePostViewModel(post).render.listing
}
function isPinned(post) {
  return pinValue(post) > 0
}
function pinWeight(post) {
  var v = pinValue(post)
  var n = Number(v)
  return isNaN(n) ? 0 : n
}

// 首页第一页渲染置顶轮播时，列表不再重复展示置顶文章（carousel 模式）
var pinSliderActive = is_home_first_page() && !pinFlat

// flat 模式：首页第一页收集全部置顶文章，按轮播顺序置顶展示
var flatPins = []
if (pinFlat && is_home_first_page()) {
  var allPosts = site.posts.toArray() || []
  for (var fi = 0; fi < allPosts.length; fi++) {
    var fpost = allPosts[fi]
    if (!postListing(fpost).listed) {
      continue
    }
    if (isPinned(fpost)) {
      flatPins.push({post: fpost, index: fi})
    }
  }
  flatPins.sort(function(a, b) {
    var d = pinWeight(b.post) - pinWeight(a.post)
    // 权重相同保持原顺序（与轮播一致）
    return d !== 0 ? d : a.index - b.index
  })
}

function layout_post_card(layout, post, content) {
  var el = '';
  var layout = layout;
  var hero = false;
  var listing = postListing(post)
  if (layout == 'post' && listing.cover && listing.cardStyle == 'hero') {
    layout += ' photo';
    hero = true;
  }
  el += `<div class="post-card-wrap${scrollreveal(' ')}">`;
  if (hero) {
    // hero 封面卡片：背景图由 .post-card 自身背景承载（跟随 corner-shape 圆角裁剪），
    // 子图保留用于 hover 变暗/放大滤镜
    el += `<a class="post-card ${layout} card-hover card-hover--spotlight card-hover--tilt" style="--cover-url:url('${escape_html(listing.cover.replace(/'/g, '%27'))}')" href="${pretty_url(listing.href)}">`
  } else {
    el += `<a class="post-card ${layout} card-hover card-hover--spotlight card-hover--tilt" href="${pretty_url(listing.href)}">`
  }
  el += content;
  el += '</a>';
  el += '</div>';
  return el;
}

function layout_post_list(partial) {
  var el = '';
  el += `<div class="post-list post">`;
  if (flatPins.length > 0) {
    var pinnedPaths = {}
    flatPins.forEach(function(item) {
      pinnedPaths[item.post.path] = true
    })
    flatPins.forEach(function(item) {
      el += layout_post_card('post', item.post, partial(item.post));
    })
    page.posts.each(function(post){
      if (postListing(post).listed && !pinnedPaths[post.path]) {
        el += layout_post_card('post', post, partial(post));
      }
    })
  } else {
    page.posts.each(function(post){
      if (postListing(post).listed) {
        if (pinSliderActive) {
          var pinVal = pinValue(post)
          if (pinVal > 0) {
            return
          }
        }
        el += layout_post_card('post', post, partial(post));
      }
    })
  }
  el += '</div>';
  return el;
}

%>

<%- partial('_partial/main/navbar/nav_tabs_blog') %>
<%- layout_post_list(function(post){
  if (isTopicPost(post)) {
    return partial('_partial/main/post_list/post_card_legacy', {post: post})
  }
  return partial('_partial/main/post_list/post_card', {viewModel: requirePostViewModel(post)})
}) %>
<%- partial('_partial/main/post_list/paginator') %>
<% if (homeCmt && homeCmt !== false && is_home_first_page()) { %>
  <%- partial('_partial/comments/layout') %>
<% } %>
