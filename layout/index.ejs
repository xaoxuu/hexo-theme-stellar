<%
if (page.menu_id == undefined) {
  page.menu_id = 'post';
}
if (page.title && page.wiki) {
  page.robots = 'noindex,follow';
}
// 首页评论区：仅首页第一页，默认不显示，可通过 site_tree.home.comments 开启/覆盖
var homeCmt = theme.site_tree?.home?.comments
if (homeCmt && homeCmt !== false && is_home_first_page()) {
  page.comments = true;
  if (typeof homeCmt === 'object') {
    if (homeCmt.service) {
      page.comments_service = homeCmt.service;
    }
    if (homeCmt.comment_title != null) {
      page.comment_title = homeCmt.comment_title;
    }
    if (homeCmt.comment_id != null) {
      page.comment_id = homeCmt.comment_id;
    }
    var homeCommentServices = ['beaudar', 'utterances', 'giscus', 'twikoo', 'waline', 'artalk'];
    for (var i = 0; i < homeCommentServices.length; i++) {
      var key = homeCommentServices[i];
      if (homeCmt[key]) {
        page[key] = homeCmt[key];
      }
    }
  }
}

// 置顶文章样式：carousel = 轮播（默认），flat = 平铺（首页列表靠前展示）
var pinStyle = theme.article?.pin_style || 'carousel'
var pinFlat = pinStyle === 'flat'

// 与 pin_slider.ejs 保持一致的置顶判定与排序权重
function pinValue(post) {
  return post.pin != null ? post.pin : post.sticky
}
function isPinned(post) {
  var v = pinValue(post)
  return v !== false && v != null
}
function pinWeight(post) {
  var v = pinValue(post)
  if (v === true) {
    return 1
  }
  var n = Number(v)
  return isNaN(n) ? 0 : n
}

// 首页第一页渲染置顶轮播时，列表不再重复展示置顶文章（carousel 模式）
var pinSliderActive = is_home_first_page() && !pinFlat

// flat 模式：首页第一页收集全部置顶文章，按轮播顺序置顶展示
var flatPins = []
if (pinFlat && is_home_first_page()) {
  var allPosts = site.posts.toArray() || []
  for (var fi = 0; fi < allPosts.length; fi++) {
    var fpost = allPosts[fi]
    if (fpost.indexing === false) {
      continue
    }
    if (isPinned(fpost)) {
      flatPins.push({post: fpost, index: fi})
    }
  }
  flatPins.sort(function(a, b) {
    var d = pinWeight(b.post) - pinWeight(a.post)
    // 权重相同保持原顺序（与轮播一致）
    return d !== 0 ? d : a.index - b.index
  })
}

function layout_post_card(layout, post, content) {
  var el = '';
  var layout = layout;
  var hero = false;
  if (layout == 'post' && post.cover != undefined && theme.article.card_style == 'hero') {
    layout += ' photo';
    hero = true;
  }
  el += `<div class="post-card-wrap${scrollreveal(' ')}">`;
  if (hero) {
    // hero 封面卡片：背景图由 .post-card 自身背景承载（跟随 corner-shape 圆角裁剪），
    // 子图保留用于 hover 变暗/放大滤镜
    el += `<a class="post-card ${layout} card-hover card-hover--spotlight card-hover--tilt" style="--cover-url:url('${escape_html(post.cover.replace(/'/g, '%27'))}')" href="${pretty_url(post.link || post.path)}">`
  } else {
    el += `<a class="post-card ${layout} card-hover card-hover--spotlight card-hover--tilt" href="${pretty_url(post.link || post.path)}">`
  }
  el += content;
  el += '</a>';
  el += '</div>';
  return el;
}

function layout_post_list(partial) {
  var el = '';
  el += `<div class="post-list post">`;
  if (flatPins.length > 0) {
    var pinnedPaths = {}
    flatPins.forEach(function(item) {
      pinnedPaths[item.post.path] = true
    })
    flatPins.forEach(function(item) {
      el += layout_post_card('post', item.post, partial(item.post));
    })
    page.posts.each(function(post){
      if (post.indexing != false && !pinnedPaths[post.path]) {
        el += layout_post_card('post', post, partial(post));
      }
    })
  } else {
    page.posts.each(function(post){
      if (post.indexing != false) {
        if (pinSliderActive) {
          var pinVal = pinValue(post)
          if (pinVal !== false && pinVal != null) {
            return
          }
        }
        el += layout_post_card('post', post, partial(post));
      }
    })
  }
  el += '</div>';
  return el;
}

%>

<%- partial('_partial/main/navbar/nav_tabs_blog') %>
<%- layout_post_list(function(post){
  return partial('_partial/main/post_list/post_card', {post: post})
}) %>
<%- partial('_partial/main/post_list/paginator') %>
<% if (homeCmt && homeCmt !== false && is_home_first_page()) { %>
  <%- partial('_partial/comments/layout') %>
<% } %>
