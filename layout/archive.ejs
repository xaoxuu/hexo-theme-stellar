<%
page.robots = 'noindex,follow';
page.navigation ||= {}
if (page.navigation.menu == undefined) {
  page.navigation.menu = stellar_config('layout.profiles.blogIndex.navigation.activeMenu');
}
function layoutArchiveList() {
  var el = ''
  var cls = ''
  if (page.author) {
    page.title = page.author.name
    page.banner = {
      image: page.author.banner,
      avatar: page.author.avatar,
      tagline: page.author.description
    }
    el += partial('_partial/main/navbar/article_banner')
    cls += ' author'
  } else {
    page.title = __('btn.archives')
    el += partial('_partial/main/listing_nav/blog')
  }
  el += `<div class="post-list${cls} archives">`
  var years = []
  function requirePostViewModel(post) {
    var viewModel = post_view_model(post)
    if (!['post', 'topic'].includes(viewModel?.collection?.profile) || !viewModel.render?.listing) {
      throw new Error(`Stellar v2: Post ${post?.source || post?.path || '<unknown>'} 缺少归档列表 ViewModel`)
    }
    return viewModel
  }
  var posts = site.posts.filter(function(post) {
    var listing = requirePostViewModel(post).render.listing
    if (!listing.listed) return false
    return page.author == null || listing.authorId == page.author.id
  })
  posts.sort('date', -1).each(function(post) {
    post.year = date(post.date, 'YYYY')
    if (post.year && (years.includes(post.year) == false) && (post.title || post.date)) {
      years.push(post.year)
    }
  })
  for (var year of years) {
    el += `<article class="${scrollreveal('')}" id="archive">`
    el += `<div class='archive-header h4'>${year}</div>`
    posts.sort('date', -1).filter(function (post) {
      post.year = date(post.date, 'YYYY')
      return post.year == year
    }).each(function(post) {
      el += partial('_partial/main/post_list/archive_item', {viewModel: requirePostViewModel(post)})
    })
    el += `</article>`
  }
  el += `</div>`
  return el
}
function layoutDiv() {
  if (page.posts && (is_category() || is_tag())) {
    return partial('index')
  } else {
    return layoutArchiveList()
  }
}
%>
 
<%- layoutDiv() %>
