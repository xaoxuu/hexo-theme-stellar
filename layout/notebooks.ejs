<%# 笔记本列表页主体部分：复用 Wiki 列表的网格与卡片组件 %>
<div class="post-list wiki">
  <% for (var notebook of page.notebookIndex.items) { %>
    <% var cover = notebook.cover || '' %>
    <% var coverStyle = cover ? ` style="--cover-url:url('${escape_html(cover.replace(/'/g, '%27'))}')"` : '' %>
    <div class="post-card-wrap<%= scrollreveal(' ') %>">
    <a class="<%- ui_classes('wiki-card', 'hoverCard', cover ? '' : 'no-cover') %>"<%- coverStyle %> href="<%= pretty_url(notebook.href) %>">
      <%- include('_partial/main/notebook/notebook_card', { render: {listing: notebook} }) %>
    </a>
    </div>
  <% } %>
</div>
