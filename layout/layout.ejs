<%
var activeProfile = page.viewModel?.collection?.profile
var isOrdinaryPost = page.layout === 'post' && page.collection?.type !== 'topic'
if (isOrdinaryPost && (activeProfile !== 'post' || page.viewModel?.render == null)) {
  throw new Error(`Stellar v2: 普通 Post ${page.source || page.path || '<unknown>'} 缺少合法 PageViewModel.render`)
}
var postViewModel = activeProfile === 'post' ? page.viewModel : null
var html = ''

if (postViewModel) {
  function primitiveItem(kind, content) {
    return partial('_partial/primitives/item', {kind: kind, body: content})
  }
  function primitiveSection(slot, items) {
    return partial('_partial/primitives/section', {slot: slot, items: items})
  }

  var siteBackground = ''
  if (postViewModel.render.layout.siteBackground) {
    siteBackground = `<div class="sitebg"><div class="siteblur"></div></div>`
  }

  var coverSection = primitiveSection('cover', [
    primitiveItem('cover', partial('_partial/cover/index').trim())
  ])
  var coverRegion = partial('_partial/primitives/region', {
    slot: 'cover',
    body: coverSection
  })

  var leftSection = primitiveSection('sidebar', [
    primitiveItem('widget', partial('_partial/sidebar/index_leftbar', {viewModel: postViewModel}))
  ])
  var leftbarSurface = postViewModel.render.layout.leftbarSurface
  var leftRegion = partial('_partial/primitives/region', {
    slot: 'left',
    body: leftSection,
    surface: leftbarSurface,
    blur: postViewModel.render.layout.leftbarBlur
  })

  var mainSection = primitiveSection('content', [
    primitiveItem('content', body),
    primitiveItem('footer', partial('_partial/main/footer')),
    primitiveItem('mask', `<div class="main-mask" onclick="sidebar.dismiss()"></div>`)
  ])
  var mainRegion = partial('_partial/primitives/region', {
    slot: 'main',
    body: mainSection
  })

  var rightSection = primitiveSection('sidebar', [
    primitiveItem('widget', partial('_partial/sidebar/index_rightbar', {viewModel: postViewModel}).trim())
  ])
  var rightRegion = partial('_partial/primitives/region', {
    slot: 'right',
    body: rightSection
  })

  var regions = leftRegion + mainRegion + rightRegion
  html = partial('_partial/primitives/shell', {
    viewModel: postViewModel,
    preferredTheme: postViewModel.render.document.preferredTheme,
    head: partial('_partial/head', {viewModel: postViewModel}),
    siteBackground: siteBackground,
    cover: coverRegion,
    regions: regions,
    menuButton: primitiveItem('menu-button', partial('_partial/menubtn')),
    scripts: primitiveSection('scripts', [primitiveItem('scripts', partial('_partial/scripts', {viewModel: postViewModel}))])
  })
} else {
// 页面类型：索引页面还是内容页面
var page_type = 'index'
if (['post', 'page', 'wiki', null].includes(page.layout)) {
  page_type = 'content'
}
// 文章类型：技术类文章/文学类文章
var articleDefaults = stellar_config('content.article')
var article_type = articleDefaults.type
if (page_type == 'index') {
  article_type = undefined
} else if (page.article?.type?.length > 0) {
  article_type = page.article.type
} else if (theme.topic.tree[collection_id(page, "topic")]?.article?.type != null) {
  article_type = theme.topic.tree[collection_id(page, "topic")].article.type
} else if (theme.wiki.tree[collection_id(page, "wiki")]?.article?.type != null) {
  article_type = theme.wiki.tree[collection_id(page, "wiki")].article.type
}
// 是否缩进
var indent = false
if (page.article?.indent != null) {
  indent = page.article.indent
} else if (theme.topic.tree[collection_id(page, "topic")]?.article?.indent != null) {
  indent = theme.topic.tree[collection_id(page, "topic")].article.indent
} else if (theme.wiki.tree[collection_id(page, "wiki")]?.article?.indent != null) {
  indent = theme.wiki.tree[collection_id(page, "wiki")].article.indent
} else if (articleDefaults.indent != null) {
  indent = articleDefaults.indent
} else {
  indent = article_type === 'story'
}

var site_background = ''
if (theme.style.site && theme.style.site['background-image']) {
  site_background += `<div class="sitebg">`
  site_background += `<div class="siteblur"></div>`
  site_background += `</div>`
}

var mobileBrandVisible = showMobileBrand(page, {
  isHome: is_home(),
  isCategory: is_category(),
  isTag: is_tag()
})

html = `<!DOCTYPE html>`
if (theme.style.prefers_theme === 'auto') {
    html += `<html lang="${page.lang}">`
} else {
  html += `<html lang="${page.lang}" data-theme="${theme.style.prefers_theme}">`
}
  html += partial('_partial/head')
  html += `<body>`
    html += site_background
    html += `<div id="l_cover">${partial('_partial/cover/index').trim()}</div>`
    html += `<div class="l_body ${page_type}" id="start" layout="${page.layout}" type="${article_type}" ${indent ? 'text-indent' : ''}>`
      var leftbarSurface = theme.style.leftbar?.['ui-style'] === 'card' ? 'card' : 'glass'
      html += `<aside class="l_left${leftbarSurface === 'card' ? ' leftbar-card' : ''}" data-ui-surface="${leftbarSurface}">`
        html += `<div class="sidebg"></div>`
        html += `<div class="leftbar-container${theme.style.leftbar?.blur ? ' leftbar-blur' : ''}">`
          html += partial('_partial/sidebar/index_leftbar')
        html += `</div>`
      html += `</aside>`
      html += `<div class="l_main" id="main" data-ui-surface="content">`
        if (mobileBrandVisible) {
          html += partial('_partial/sidebar/brand', {placement: 'main'})
        }
        html += body
        html += partial('_partial/main/footer')
        html += `<div class="main-mask" onclick="sidebar.dismiss()"></div>`
      html += `</div>`
      html += `<aside class="l_right" data-ui-surface="sidebar">`
        html += partial('_partial/sidebar/index_rightbar').trim()
      html += `</aside>`
      html += partial('_partial/menubtn')
    html += `</div>`
    html += `<div class="scripts">`
      html += partial('_partial/scripts')
    html += `</div>`
  html += `</body>`
html += `</html>`
}
%>
<%- html %>
