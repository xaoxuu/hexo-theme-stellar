.md-text a[data-md-link] > .md-link-icon,
.article-footer a[data-md-link] > .md-link-icon
  --ui-icon-size: 1.2em
  --ui-icon-opacity: 1
  vertical-align: middle
  margin-bottom: .2em
  img
    border-radius: 100%
    corner-shape: round
    height: 80%
    width: 80%
.md-text a[data-md-link]:hover > .md-link-icon,
.article-footer a[data-md-link]:hover > .md-link-icon
  color: var(--link)
