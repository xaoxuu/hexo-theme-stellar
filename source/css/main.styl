// 无需修改的常量
@import '_defines/const'

// 自定义参数
@import '_custom'

// 含自定义参数的常量以及函数
@import '_defines/theme_base'
@import '_defines/theme_colorful'
@import '_defines/func'

// 通用组件
@import '_common/*'
// 布局
@import '_components/*'

// 可选插件
@import '_plugins/index'

// 每次构建只编译当前整站 Appearance，作为最终视觉实现层。
@require '_appearances/_mixins'
$appearance-preset = hexo-config('appearance.preset')
if $appearance-preset == 'card'
  @import '_appearances/card'
else if $appearance-preset == 'glass'
  @import '_appearances/glass'
else if $appearance-preset == 'minimal'
  @import '_appearances/minimal'
else if $appearance-preset == 'flat'
  @import '_appearances/flat'
