.navbar
  z-index: 8
  top: var(--gap-margin)
  position: sticky
  position: -webkit-sticky

.navbar-blur 
  margin: 0 1rem
  position: relative
  bar-glass()

.navbar-container 
  max-width: 100%
  margin: 1px
  border-radius: $border-bar-container
  overflow: scroll visible
  scrollbar(0, 0)
  
.navbar nav
  display: inline-flex
  font-size: $fs-14
  gap: $bar-item-gap
  padding: $bar-item-gap
  z-index: 1
  >p
    margin: 0
  a
    bar-item()
    &:hover
      background: var(--bg-a50)
    &.active, &:hover
      color: var(--text)
    &.active
      bar-item-active()
      cursor default
      pointer-events: none
    &.active:after
      content: ''

@media screen and (max-width: $device-mobile-max)
  .navbar.top
    top: 8pt
    
