// 面包屑导航
.bread-nav
  font-weight: 500
  color: var(--text-banner-theme, var(--text-banner))
  .left
    flex: 1
    min-width: 0
    display: flex
    align-items: baseline
  .flex-row
    display: flex
    align-items: baseline
    flex-direction: row
  a
    color: var(--text-banner-theme, var(--text-banner))
    padding: 4px
    border-radius: 2px
    &:hover
      background: var(--button-hover-bg)
  span 
    color: var(--text-banner-theme, var(--text-banner))
  span.sep
    opacity 0.5
    margin: 0
  span.text
    padding: 4px

  div#post-meta
    span.sep:before
      content: '|'
    span.updated
      visibility: hidden
  &:hover
    div#post-meta span.updated
      visibility: visible

// 文章 AI 成分标签：彩色文字、无背景，颜色由内联 style 提供（banner 含图片时继承默认色）
.ai-label
  display: inline-flex
  align-items: center
  gap: 4px
  padding: 4px
  white-space: nowrap
  svg
    height: 1em
    width: auto
    transform: scale(1.25)

.bread-nav .ghrepo
  font-size: $fs-13
  display: flex
  flex-direction: column
  align-items: flex-start
  border-left: 1px solid var(--text-meta)
  padding-left: 8px
  a  
    display: flex
    align-items: center
    color: var(--text-banner-theme, var(--text-banner))
    svg
      margin-right: 4px
    &.bold 
      font-weight: 600
      color: var(--text-banner-theme, var(--text-banner))
    span 
      margin-left: 4px
    &:hover
      opacity 1
