.highlight
  position: relative

.highlight .code .copy-btn
  position: absolute
  top: 0
  right: 0
  width: 2rem
  height: 2rem
  padding: .375rem
  box-sizing: border-box
  border: 0
  visibility: hidden
  background: none
  color: var(--text-p3)
  display: flex
  align-items: center
  justify-content: center
  cursor: pointer
  margin-right: 4px
  margin-top: 4px
  .icon
    width: 100%
    height: 100%
  &:hover
    color: x-theme-alpha(1)

.highlight:hover, .highlight:focus-within
  .code:before
    visibility: hidden
  .copy-btn 
    visibility: visible

.md-text .folding[child=codeblock]
  .code .copy-btn
    z-index 1
    margin-right: 1rem
